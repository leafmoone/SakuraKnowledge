# Raw evidence must be byte-verbatim: no EOL normalization, no diff text.
reports/P2/raw/** -text -diff
# New f99 review receipts bind byte-verbatim; historical receipts remain untouched.
reports/P2/review-f99-*.json -text -diff
reports/P2/review-b754-*.json -text -diff
# New P3 receipts and replay decisions bind exact committed bytes.
reports/P3/*.json -text -diff
reports/P3/*.jsonl -text -diff
# A-L new raw streams are stored once and committed byte-verbatim.
reports/P3/close-raw/** -text -diff
