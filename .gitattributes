# Source text remains portable; never normalize binary resource bytes.
* text=auto
*.py text eol=lf
*.rs text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.dll -text
*.exe -text
*.sqlite -text
*.onnx -text
*.npy -text
*.usearch -text
