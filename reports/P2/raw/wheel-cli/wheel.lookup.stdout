{"contract_version": "2", "snapshot": "7e1592a61452d437ae46fab589317d2ac7b10c5a02c6c966097fa679a963a57c", "query": "975", "status": "ambiguous", "entry_key": null, "tag_key": null, "canonical": null, "candidates": [{"entry_key": {"kind": "character", "namespace": "bangumi.character", "value": "975"}, "locator": null, "descriptions": [{"title": "オルゴン", "original": "真名为“千征令”的红世魔王，为红世使徒邪恶组织“化妆舞会”之成员，外表为穿戴绿色帽子及大披风的隐形客。贝露佩欧露直属部下，极度傲慢，受不了侮辱。使用自在法构成的队伍“军团”作战。作战被维奈利用作阻挡“万条巧手”的工具，最终被“虹天剑”一刀砍杀。似乎曾经与梅利希姆在过去交手。炎色为铜绿。", "response_truncated": 0, "search_text_truncated": 0, "source_id": "bangumi-complete-6a75aefb769a", "evidence_id": "bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:690993", "status": "source_backed"}], "matched_documents": [{"title": "オルゴン", "original": "真名为“千征令”的红世魔王，为红世使徒邪恶组织“化妆舞会”之成员，外表为穿戴绿色帽子及大披风的隐形客。贝露佩欧露直属部下，极度傲慢，受不了侮辱。使用自在法构成的队伍“军团”作战。作战被维奈利用作阻挡“万条巧手”的工具，最终被“虹天剑”一刀砍杀。似乎曾经与梅利希姆在过去交手。炎色为铜绿。", "response_truncated": 0, "search_text_truncated": 0, "source_id": "bangumi-complete-6a75aefb769a", "evidence_id": "bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:690993", "status": "source_backed"}], "aliases": [], "identity_evidence": [{"source_id": "bangumi-complete-6a75aefb769a", "evidence_id": "bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:690993", "status": "source_backed", "type": "character", "locator": null, "payload": "{\"key\": {\"kind\": \"character\", \"namespace\": \"bangumi.character\", \"value\": \"975\"}, \"status\": \"source_backed\", \"raw\": {\"id\": 975, \"role\": 1, \"infobox\": \"{{Infobox Crt\\r\\n|简体中文名=奥尔冈\\r\\n|声优=斧アツシ\\r\\n|性别=男（？）\\r\\n|生日=\\r\\n|血型=\\r\\n|身高=\\r\\n|体重=\\r\\n|BWH=\\r\\n}}\", \"summary\": \"真名为“千征令”的红世魔王，为红世使徒邪恶组织“化妆舞会”之成员，外表为穿戴绿色帽子及大披风的隐形客。贝露佩欧露直属部下，极度傲慢，受不了侮辱。使用自在法构成的队伍“军团”作战。作战被维奈利用作阻挡“万条巧手”的工具，最终被“虹天剑”一刀砍杀。似乎曾经与梅利希姆在过去交手。炎色为铜绿。\", \"comments\": 0, \"collects\": 0}}"}]