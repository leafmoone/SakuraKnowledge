s":[{"title":"冷静とモフモフの国境線","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:159291","status":"source_backed"}],"matched_documents":[{"title":"冷静とモフモフの国境線","original":"","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:159291"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:159291","status":"source_backed","type":"subject","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:159291","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:159291"}],"score":-11.94934458401361},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"15836"},"locator":null,"descriptions":[{"title":"ロクサス","original":"洛克萨斯是《王国之心》系列中的角色，在NDS平台作品《王国之心：358/2天》中作为主人公登场。\r\n\r\n他是正传主角索拉（Sora）的“无存”，在《王国之心》第一部结尾索拉变为无心者时诞生于黄昏镇，后被XIII机关首领杰姆那斯发现并招募为该组织的第十三号成员。洛克萨斯能够使用键刃，并因继承了文图斯与索拉的能力而可以使用两把键刃。在机关中，他与前辈阿克塞尔成为好友，并与后来加入的第十四号成员希恩共同行动，三人常在黄昏镇的钟楼聚会，被称为“海盐冰组”。然而希恩实为杰姆那斯制造的、用于吸收洛克萨斯力量的复制人，最终在钟楼与洛克萨斯战斗后消失。洛克萨斯随后意图挑战杰姆那斯，但被利库击败。战败后，洛克萨斯的记忆被删除，意识被放入虚拟的黄昏镇。他最终在记忆荚中见到了沉睡的索拉，并接受了自己将回归本体的命运。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:704871","status":"source_backed"}],"matched_documents":[{"title":"ロクサス","original":"洛克萨斯是《王国之心》系列中的角色，在NDS平台作品《王国之心：358/2天》中作为主人公登场。\r\n\r\n他是正传主角索拉（Sora）的“无存”，在《王国之心》第一部结尾索拉变为无心者时诞生于黄昏镇，后被XIII机关首领杰姆那斯发现并招募为该组织的第十三号成员。洛克萨斯能够使用键刃，并因继承了文图斯与索拉的能力而可以使用两把键刃。在机关中，他与前辈阿克塞尔成为好友，并与后来加入的第十四号成员希恩共同行动，三人常在黄昏镇的钟楼聚会，被称为“海盐冰组”。然而希恩实为杰姆那斯制造的、用于吸收洛克萨斯力量的复制人，最终在钟楼与洛克萨斯战斗后消失。洛克萨斯随后意图挑战杰姆那斯，但被利库击败。战败后，洛克萨斯的记忆被删除，意识被放入虚拟的黄昏镇。他最终在记忆荚中见到了沉睡的索拉，并接受了自己将回归本体的命运。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:704871"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:704871","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:704871","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:704871"}],"score":-11.51882249379351},{"entry_key":{"kind":"subject","namespace":"bangumi.subject","value":"419477"},"locator":null,"descriptions":[{"title":"ペンフレンド ～国境を越えた色仕掛けの罠～","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:406513","status":"source_backed"}],"matched_documents":[{"title":"ペンフレンド ～国境を越えた色仕掛けの罠～","original":"","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id