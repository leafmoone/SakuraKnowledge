":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1876848","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1876848","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1876848","original":"食堂の地下室に通う小橋美琴は、紫の女が月川涙という名のタルパであることを突き止める。心霊スポットを訪れた若者三人組のうちの一人が、人型に折られた紙片を手渡される。美琴と別れた郷内が新宿の街を歩いていると、血だらけの月川涙が横たわっていた。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"903047"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1876848","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1876848","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1876848","original":"食堂の地下室に通う小橋美琴は、紫の女が月川涙という名のタルパであることを突き止める。心霊スポットを訪れた若者三人組のうちの一人が、人型に折られた紙片を手渡される。美琴と別れた郷内が新宿の街を歩いていると、血だらけの月川涙が横たわっていた。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1877637","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1877637","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1877637","original":"気がつけば野郎組の中で女子と話せない病は、一条（髙橋優斗）だけになっていた。花岡（濵田崇裕）は、必ず治ると、昔自分の親友が同じ病にかかった話をする。そんな中、アスカ（茅島みずき）の好きな男子が野郎組にいるという衝撃のニュースが！しかし、自分でないとわかった一条はさらに落ち込み、野郎組の解散を申し出た。いつも一緒に走ってきた仲間を助けようと、一条のために野郎組が再び立ち上がる！","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"903858"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1877637","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1877637","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1877637","original":"気がつけば野郎組の中で女子と話せない病は、一条（髙橋優斗）だけになっていた。花岡（濵田崇裕）は、必ず治ると、昔自分の親友が同じ病にかかった話をする。そんな中、アスカ（茅島みずき）の好きな男子が野郎組にいるという衝撃のニュースが！しかし、自分でないとわかった一条はさらに落ち込み、野郎組の解散を申し出た。いつも一緒に走ってきた仲間を助けようと、一条のために野郎組が再び立ち上がる！","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1896145","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1896145","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1896145","original":"長男・唯一（黒羽麻璃央）の会社の後輩・楢原（高橋健介）がやって来て、次男・天授（鳥越裕貴）、三男・ガイ（眞嶋秀斗）も含めて4人で一緒に鍋を囲むことに。床に座って鍋を食べるのは初めてだという楢原から、悪気はないけどちょっと失礼なマイペース発言がどんどん飛び出し…。なんだかガイと波長が合うみたい！？\r\nそして楢原が唯一にしたかった大事な相談事とは…？\r\n他「脱出ゲーム」の2本立て。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"922665"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1896145","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1896145","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1896145","original":"長男・唯一（黒羽麻璃央）の会社の後輩・楢原（高橋健介）がやって来て、次男・天授（鳥越裕貴）、三男・ガイ（眞嶋秀斗）も含めて4人で一緒に鍋を囲むことに。床に座って鍋を食べるのは初めてだという楢原から、悪気はないけどちょっと失礼なマイペース発言がどんどん飛び出し…。なんだかガイと波長が合うみたい！？\r\nそして楢原が唯一にしたかった大事な相談事とは…？\r\n他「脱出ゲーム」の2本立て。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1899157","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1899157","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1899157","original":"選挙に立候補することになった義男にはどうしても消したい黒歴史のSNSが３つあった。厨二病丸出しのSNS、パンクロックに憧れていた高校時代のSNS、そして悪口のオンパレードの裏アカ。このうちのどれがバレても即アウト。しかしパスワードが思い出せない。過去の自分と向き合いながら、義男は忘れていた様々なことを思い出す。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"925723"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1899157","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1899157","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1899157","original":"選挙に立候補することになった義男にはどうしても消したい黒歴史のSNSが３つあった。厨二病丸出しのSNS、パンクロックに憧れていた高校時代のSNS、そして悪口のオンパレードの裏アカ。このうちのどれがバレても即アウト。しかしパスワードが思い出せない。過去の自分と向き合いながら、義男は忘れていた様々なことを思い出す。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913647","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913647","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913647","original":"番組内容\r\n    福島県相馬の“はね駒（こんま）”（おてんば娘）りんが、仙台の女学校で英語を学び、結婚・出産を経て女性新聞記者の草分けとなる物語。１９８６年放送の連続テレビ小説。\r\n\r\n詳細\r\n    橘りん（斉藤由貴）は、いいなずけの新之助（益岡徹）との結婚に全く気が進まなかった。学校の大場先生（角野卓造）に相談したりんは、ついに新之助に結納の延期を申し出る。そんななか、叔父の彌七（ガッツ石松）が、小野寺源造（渡辺謙）を連れてやって来る。\r\n\r\n出演者ほか\r\n    【作】寺内小春，【出演】斉藤由貴，樹木希林，渡辺謙，小林稔侍，矢崎滋，綿引勝彦，角野卓造，岡本茉利，益岡徹，丹阿弥谷津子，ガッツ石松，山内明，【語り】細川俊之，【音楽】三枝成彰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"940718"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913647","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913647","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913647","original":"番組内容\r\n    福島県相馬の“はね駒（こんま）”（おてんば娘）りんが、仙台の女学校で英語を学び、結婚・出産を経て女性新聞記者の草分けとなる物語。１９８６年放送の連続テレビ小説。\r\n\r\n詳細\r\n    橘りん（斉藤由貴）は、いいなずけの新之助（益岡徹）との結婚に全く気が進まなかった。学校の大場先生（角野卓造）に相談したりんは、ついに新之助に結納の延期を申し出る。そんななか、叔父の彌七（ガッツ石松）が、小野寺源造（渡辺謙）を連れてやって来る。\r\n\r\n出演者ほか\r\n    【作】寺内小春，【出演】斉藤由貴，樹木希林，渡辺謙，小林稔侍，矢崎滋，綿引勝彦，角野卓造，岡本茉利，益岡徹，丹阿弥谷津子，ガッツ石松，山内明，【語り】細川俊之，【音楽】三枝成彰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1950860","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1950860","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1950860","original":"三途の川から生還したタカオ(上田竜也)だったが、その頃IT社長の内田はマキコへプロポーズする計画を進めていた。タイムリミットが迫る中、タカオは稲葉(重岡大毅)、桑田、リンの力を借りて、マキコを節約デートに誘いだす……","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"978486"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1950860","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1950860","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1950860","original":"三途の川から生還したタカオ(上田竜也)だったが、その頃IT社長の内田はマキコへプロポーズする計画を進めていた。タイムリミットが迫る中、タカオは稲葉(重岡大毅)、桑田、リンの力を借りて、マキコを節約デートに誘いだす……","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954370","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954370","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954370","original":"番組内容\r\n    “陸（おか）者”と“海者”が対立する港町での、しょうゆ醸造の旧家の娘・かをる（沢口靖子）と網元の跡取り息子の波乱万丈の愛の物語。１９８５年放送の連続テレビ小説。\r\n\r\n出演者ほか\r\n    【作】ジェームス三木，【出演】沢口靖子，川野太郎，柴田恭兵，根岸季衣，岩本多代，鷲生功，高品格，鷲尾真知子，高橋珠美子，加藤和恵，村田雄浩，葛西和雄，加賀まりこ，津川雅彦，【語り】葛西聖司，【音楽】池辺晋一郎 \r\n\r\n詳細\r\n    学校で掃除中もぼんやりしてしまうかをる（沢口靖子）を友人の由岐（高橋珠美子）がからかうので、けんかになってしまう。家に帰ってもふさぎこんでしまうかをるにるい（加賀まりこ）は声をかけるが、かをるは相手にしない。たまらず夜中に家を飛び出して、由岐の家を訪ねて謝り仲直りする。かをるの不在に、家ではるいとツエ（鷲尾真知子）が慌てる。由岐の家からの帰りに、雪に足を滑らせて転んだかをるに声をかけたのは…。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"982072"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954370","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954370","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954370","original":"番組内容\r\n    “陸（おか）者”と“海者”が対立する港町での、しょうゆ醸造の旧家の娘・かをる（沢口靖子）と網元の跡取り息子の波乱万丈の愛の物語。１９８５年放送の連続テレビ小説。\r\n\r\n出演者ほか\r\n    【作】ジェームス三木，【出演】沢口靖子，川野太郎，柴田恭兵，根岸季衣，岩本多代，鷲生功，高品格，鷲尾真知子，高橋珠美子，加藤和恵，村田雄浩，葛西和雄，加賀まりこ，津川雅彦，【語り】葛西聖司，【音楽】池辺晋一郎 \r\n\r\n詳細\r\n    学校で掃除中もぼんやりしてしまうかをる（沢口靖子）を友人の由岐（高橋珠美子）がからかうので、けんかになってしまう。家に帰ってもふさぎこんでしまうかをるにるい（加賀まりこ）は声をかけるが、かをるは相手にしない。たまらず夜中に家を飛び出して、由岐の家を訪ねて謝り仲直りする。かをるの不在に、家ではるいとツエ（鷲尾真知子）が慌てる。由岐の家からの帰りに、雪に足を滑らせて転んだかをるに声をかけたのは…。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:1","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:1","original":"An original work or character that isn't from any established [[howto:copyright|copyright]]. Basically, art that is not fanart.\r\n\r\nThis includes [[scenery]], [[still life]]s, [[animal focus]] posts, and other works with [[no humans]] or no known characters.\r\n\r\nSome art may depict original characters alongside characters from established copyrights, or a fan-made character of a specific copyright. In this case, the art should be tagged as original and with the tag for the copyright, and the tag [[OC x canon]] applied if applicable.\r\n\r\nIf the artwork shows a [i]different artist's[/i] original character, include the [[borrowed character]] tag as well.\r\n\r\nSome works on Pixiv are occasionally tagged original by accident. Art by the character designer for an established copyright also sometimes tag their work as original—on Danbooru, these should be tagged with the corresponding copyright instead.\r\n\r\nh4. Examples\r\n\r\n* !post #10154315: [[Danbooru-tan]] by [[Shibidayo]]\r\n* !post #3068019\r\n* !post #7896695\r\n\r\nh4. See also\r\n\r\n* [[borrowed character]]\r\n* [[commissioner insert]]\r\n* [[OC x canon]]\r\n* [[real life]] - fanart of real people\r\n* [[adoptable]]\r\n* [[copyright request]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"original"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"10"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:1","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:1","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"exact","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:1","original":"An original work or character that isn't from any established [[howto:copyright|copyright]]. Basically, art that is not fanart.\r\n\r\nThis includes [[scenery]], [[still life]]s, [[animal focus]] posts, and other works with [[no humans]] or no known characters.\r\n\r\nSome art may depict original characters alongside characters from established copyrights, or a fan-made character of a specific copyright. In this case, the art should be tagged as original and with the tag for the copyright, and the tag [[OC x canon]] applied if applicable.\r\n\r\nIf the artwork shows a [i]different artist's[/i] original character, include the [[borrowed character]] tag as well.\r\n\r\nSome works on Pixiv are occasionally tagged original by accident. Art by the character designer for an established copyright also sometimes tag their work as original—on Danbooru, these should be tagged with the corresponding copyright instead.\r\n\r\nh4. Examples\r\n\r\n* !post #10154315: [[Danbooru-tan]] by [[Shibidayo]]\r\n* !post #3068019\r\n* !post #7896695\r\n\r\nh4. See also\r\n\r\n* [[borrowed character]]\r\n* [[commissioner insert]]\r\n* [[OC x canon]]\r\n* [[real life]] - fanart of real people\r\n* [[adoptable]]\r\n* [[copyright request]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"original"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912038","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912038","original":"日本のアニメーター、アニメ演出家、監督。元・スタジオエックス所属。北海道出身。\r\n\r\n『ドラえもん』（大山のぶ代時代初期）で動画デビュー。その後は原画、作画監督、キャラクターデザイン、演出、監督と様々な役職を経て、2011年現在は演出が主となっている。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"長岡康史"}],"entry_key":{"kind":"person","namespace":"bangumi.person","value":"10"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912038","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912038","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"person"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"exact","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912038","original":"日本のアニメーター、アニメ演出家、監督。元・スタジオエックス所属。北海道出身。\r\n\r\n『ドラえもん』（大山のぶ代時代初期）で動画デビュー。その後は原画、作画監督、キャラクターデザイン、演出、監督と様々な役職を経て、2011年現在は演出が主となっている。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"長岡康史"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:7","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:7","original":"ちぃのベストショット満載！！\r\nファン待望の『ちょびっツ』原画集\r\n\r\n『ちょびっツ』連載開始から2年。\r\nヤンマガはもとより、グッズやCD、DVD等に描きおろされたイラストの中から、フォトジェニックなちぃを集めて一冊の原画集にします！\r\nちぃのかわいさがぎっしりつまった画集、買い逃し厳禁だ！","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"Your Eyes Only ちぃフォトグラフィクス"}],"entry_key":{"kind":"subject","namespace":"bangumi.subject","value":"10"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:7","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:7","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"subject"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"exact","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:7","original":"ちぃのベストショット満載！！\r\nファン待望の『ちょびっツ』原画集\r\n\r\n『ちょびっツ』連載開始から2年。\r\nヤンマガはもとより、グッズやCD、DVD等に描きおろされたイラストの中から、フォトジェニックなちぃを集めて一冊の原画集にします！\r\nちぃのかわいさがぎっしりつまった画集、買い逃し厳禁だ！","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"Your Eyes Only ちぃフォトグラフィクス"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5d