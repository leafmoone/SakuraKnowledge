,"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1516648","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1516648","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1516648","original":"後に裏の麻雀界で伝説として語り継がれたアカギ対鷲巣の闘い…\r\nその６回戦・南１局１本場、アカギは鷲巣へ親満を直撃し、鷲巣の資金６億円全てを奪い取るだけでなく、血を抜かせるまで追い詰める。\r\n「金が足りぬ分は血だ！ワシの血を抜け！」と叫ぶ鷲巣。\r\nそんな鷲巣にアカギは「俺の親を止められなきゃ、お前は死ぬ！」と言い放つ。ついに互いの血を賭けた狂気の『鷲巣麻雀』そのクライマックスが訪れようとしていた－","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"532064"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1516648","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1516648","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1516648","original":"後に裏の麻雀界で伝説として語り継がれたアカギ対鷲巣の闘い…\r\nその６回戦・南１局１本場、アカギは鷲巣へ親満を直撃し、鷲巣の資金６億円全てを奪い取るだけでなく、血を抜かせるまで追い詰める。\r\n「金が足りぬ分は血だ！ワシの血を抜け！」と叫ぶ鷲巣。\r\nそんな鷲巣にアカギは「俺の親を止められなきゃ、お前は死ぬ！」と言い放つ。ついに互いの血を賭けた狂気の『鷲巣麻雀』そのクライマックスが訪れようとしていた－","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1519965","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1519965","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1519965","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"535812"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1519965","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1519965","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1519965","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1579588","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1579588","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1579588","original":"出演者ほか\r\n    【原作】又吉直樹，【出演】林遣都，波岡一喜，門脇麦，好井まさお，村田秀亮，高橋メアリージュン，菜葉菜，染谷将太，山本彩，渡辺哲，田口トモロヲ，小林薫 \r\n\r\n解散が決まったスパークスは、所属事務所主催のライブで最後の漫才を披露することに。解散当日、会場には神谷（波岡一喜）、百合枝、徳永の母の姿も。そしてスパークスは、こん身のネタで観客を笑顔と涙の渦に巻き込んでいく。一年後、徳永（林遣都）は不動産屋で働いていた。ある日、神谷の相方・大林から呼び出された徳永は、神谷の失踪を知る。そして仕事に戻った徳永に神谷から電話が入り…。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"597335"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1579588","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1579588","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1579588","original":"出演者ほか\r\n    【原作】又吉直樹，【出演】林遣都，波岡一喜，門脇麦，好井まさお，村田秀亮，高橋メアリージュン，菜葉菜，染谷将太，山本彩，渡辺哲，田口トモロヲ，小林薫 \r\n\r\n解散が決まったスパークスは、所属事務所主催のライブで最後の漫才を披露することに。解散当日、会場には神谷（波岡一喜）、百合枝、徳永の母の姿も。そしてスパークスは、こん身のネタで観客を笑顔と涙の渦に巻き込んでいく。一年後、徳永（林遣都）は不動産屋で働いていた。ある日、神谷の相方・大林から呼び出された徳永は、神谷の失踪を知る。そして仕事に戻った徳永に神谷から電話が入り…。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1603496","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"10"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1603496","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1603496","original":"ついに牧生（窪田正孝）の真実が明かされた。零（藤ヶ谷太輔）とキラ（飯豊まりえ）は運命的に出会い、互いに心が通じ合ったように思えたが、実は全て牧生の手のひらの上で転がされていた！？\r\n衝撃の最終回、零とキラ、そして牧生の想いはどんどん加速する―。\r\n特別映像も公開！","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"622300"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1603496","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1603496","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"episode"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1603496","original":"ついに牧生（窪田正孝）の真実が明かされた。零（藤ヶ谷太輔）とキラ（飯豊まりえ）は運命的に出会い、互いに心が通じ合ったように思えたが、実は全て牧生の手のひらの上で転がされていた！？\r\n衝撃の最終回、零とキラ、そして牧生の想いはどんどん加速する―。\r\n特別映像も公開！","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"10"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0e