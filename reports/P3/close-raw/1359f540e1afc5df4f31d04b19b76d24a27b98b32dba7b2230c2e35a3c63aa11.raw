{"case_id":"G21","elapsed_s":0.000502,"value":{"candidates":[],"candidates_truncated":false,"canonical_status":"canonical","citations":[],"contract_version":"2","descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:109290","original":"Main character in [[Bocchi the Rock!]]. Also known by her titular nickname \"Bocchi\", an introverted girl with an exceptional skill at playing [[guitar]]. She struggled to find any friends due to her social anxiety until she joined the Kessoku Band at the request of [[Ijichi Nijika]].\r\n\r\nShe has [[blue eyes]] and [[long hair|long]] [[pink hair]] with a [[one side up]], [[large breasts]] (according to ch. 4 of the manga)  & [[hair between eyes]] (sometimes depicted with [[hair over eyes]]). She usually wears a [[cube hair ornament]], a [[pink jacket|pink]] [[track jacket]], a [[grey skirt|grey]] [[pleated skirt]], [[black socks]], and [[brown footwear|brown]] [[loafers]]. Other times depicted wearing [[pink pants|pink]] [[track pants|track]] [[pants under skirt|pants under her skirt]]. She [[playing instrument|plays]] the [[Gibson Les Paul]] [[Electric Guitar]], which she is usually depicted [[holding instrument|holding]] or keeping in [[instrument case|guitar case]].\r\n\r\nShe is voiced by [[Aoyama Yoshino]] and portrayed by [[Morino Mamo]] in the stage-play.\r\n\r\nNot to be confused with [[Hitori Bocchi]] from [i][[Hitoribocchi no Marumaru Seikatsu]][/i].\r\n\r\nh4. Appearance\r\n\r\n* !post #7506349\r\n* !post #8165071\r\n* !post #8587749: [[Gotoh Hitori (tsuchinoko)|Tsuchinoko]]\r\n* !post #6609730: [[Gotoh Hitori (octopus)|Octopus]]\r\n\r\nh4. See also\r\n\r\n* \"Bocchi's Stress-induced Transformations\":[/pools/20401]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"gotoh_hitori"}],"evidence_chain":[{"evidence_id":"native:1964304","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"native_identity","source_id":"danbooru-native-scoped-4ccce02e466f","tag_id":1964304},{"active_alias_ids":[],"coverage":"scoped_complete","evidence_id":"scope:gotoh_hitori","fetched_at_utc":"2026-09-30T06:43:46.355168+00:00","name":"gotoh_hitori","raw_path":"reports/P3/raw/4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945.raw","raw_sha256":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","role":"canonical_scope","source_id":"danbooru-native-scoped-4ccce02e466f"},{"association":"official embedded tag.wiki_page","evidence_id":"wiki:115616","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"wiki_tag_link","source_id":"danbooru-native-scoped-4ccce02e466f","tag_id":1964304,"tag_key":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"wiki_id":115616,"wiki_key":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}},{"body_sha256":"564dd24d5e8cdbfaeb5d96dfa6c86e700044204a1815cb42e52fe65e6e39e156","evidence_id":"wiki-cut:115616","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","live_body_sha256":"564dd24d5e8cdbfaeb5d96dfa6c86e700044204a1815cb42e52fe65e6e39e156","live_other_names_sha256":"e21fb5219a12eb401f9c31977dae66e78aa8c170889ab3ddd90934634c90f195","live_updated_at":"2026-06-20T01:19:40.398-04:00","old_body_sha256":"564dd24d5e8cdbfaeb5d96dfa6c86e700044204a1815cb42e52fe65e6e39e156","old_evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:109290","old_input_sha256":"a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5","old_line":109290,"old_other_names_sha256":"e21fb5219a12eb401f9c31977dae66e78aa8c170889ab3ddd90934634c90f195","old_path":"D:\\SakuraTool\\SakuraKnowledge\\build\\real-full-7afe7fb\\danbooru.jsonl","old_source_id":"danbooru-complete-a26a3829dd42","old_updated_at":"2026-06-20T01:19:40.398-04:00","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"wiki_cut_compatibility","rule":"exact body+updated_at+other_names; no live overwrite","source_id":"danbooru-native-scoped-4ccce02e466f","tag_key":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"wiki_key":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}},{"evidence_id":"wiki:115616","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","language":"unknown","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"multilingual_name","source_id":"danbooru-native-scoped-4ccce02e466f","text":"后藤一里","wiki_id":115616},{"dst":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"evidence_id":"danbooru-native-scoped-4ccce02e466f:6fbdc0b9462bcfa1931dcdb5dd1694c8cca4b04a3440bd74eb3ee6a582647b16:line:31","role":"wiki_association_edge","source_id":"danbooru-native-scoped-4ccce02e466f","src":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}},{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:109290","role":"description","source_id":"danbooru-complete-a26a3829dd42","tag_key":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"wiki_key":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}}],"matched_by":"wiki_name","query":"后藤一里","relations":[],"requested_category":null,"requested_namespace":"danbooru.tag","resolver_contract_version":"1","response_version":"3","snapshot":"373fcb69731db87