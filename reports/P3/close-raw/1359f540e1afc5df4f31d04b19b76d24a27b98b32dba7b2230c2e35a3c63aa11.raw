a256":"e21fb5219a12eb401f9c31977dae66e78aa8c170889ab3ddd90934634c90f195","old_path":"D:\\SakuraTool\\SakuraKnowledge\\build\\real-full-7afe7fb\\danbooru.jsonl","old_source_id":"danbooru-complete-a26a3829dd42","old_updated_at":"2026-06-20T01:19:40.398-04:00","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"wiki_cut_compatibility","rule":"exact body+updated_at+other_names; no live overwrite","source_id":"danbooru-native-scoped-4ccce02e466f","tag_key":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"wiki_key":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}},{"evidence_id":"wiki:115616","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","language":"unknown","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"multilingual_name","source_id":"danbooru-native-scoped-4ccce02e466f","text":"后藤一里","wiki_id":115616},{"dst":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"evidence_id":"danbooru-native-scoped-4ccce02e466f:6fbdc0b9462bcfa1931dcdb5dd1694c8cca4b04a3440bd74eb3ee6a582647b16:line:31","role":"wiki_association_edge","source_id":"danbooru-native-scoped-4ccce02e466f","src":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}},{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:109290","role":"description","source_id":"danbooru-complete-a26a3829dd42","tag_key":{"kind":"tag","namespace":"danbooru.tag","value":"gotoh_hitori"},"wiki_key":{"kind":"page","namespace":"danbooru.wiki","value":"115616"}}],"matched_by":"wiki_name","query":"后藤一里","relations":[],"requested_category":null,"requested_namespace":"danbooru.tag","resolver_contract_version":"1","response_version":"3","snapshot":"373fcb69731db8