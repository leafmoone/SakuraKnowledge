{"contract_version":"2","response_version":"3","snapshot":"373fcb69731db877929c102b75292142c0ccff1b5f6075310acc03432ddb6b8b","query":"小早川美幸","status":"entity_ambiguous","entry_key":null,"tag_key":null,"canonical":null,"candidates":[{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"9347"},"locator":null,"descriptions":[{"title":"小早川美幸","original":"巡查。冷静、溫和、頭腦清晰，然是個重度的機械狂。有暴走傾向，和平常安靜的形象差異頗大。和中嶋是情人的關係不過遲遲沒有進展（漫画的最后一话78话有让中岛预约婚礼会场，作者在似乎暗示她和中岛会有情人终成眷属）。動畫播放1st season裡是23歲身高：166cm、三圍：93、56、95，血型A型。2nd season裡是設定為2年後的25歲。籍貫在岡山縣，現居住於江東區。住處在警局附近的公寓，與夏實同居。髮型在原作裡最初是短髮，不過漸漸變長後盤了起來（動畫版一開始即為盤髮）。被好球侠称为“全垒打女2號”。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:698573","status":"source_backed"}],"matched_documents":[{"title":"小早川美幸","original":"巡查。冷静、溫和、頭腦清晰，然是個重度的機械狂。有暴走傾向，和平常安靜的形象差異頗大。和中嶋是情人的關係不過遲遲沒有進展（漫画的最后一话78话有让中岛预约婚礼会场，作者在似乎暗示她和中岛会有情人终成眷属）。動畫播放1st season裡是23歲身高：166cm、三圍：93、56、95，血型A型。2nd season裡是設定為2年後的25歲。籍貫在岡山縣，現居住於江東區。住處在警局附近的公寓，與夏實同居。髮型在原作裡最初是短髮，不過漸漸變長後盤了起來（動畫版一開始即為盤髮）。被好球侠称为“全垒打女2號”。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:698573","status":"source_backed"}],"aliases":[{"text":"小早川美幸","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:698573","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:698573","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_eviden