fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912075","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912075","original":"Key是Visual Art's旗下的一个游戏品牌，主要产品线集中在美少女游戏（含十八禁游戏）。著名作品有Kanon、AIR、CLANNAD。三作皆以“催泪美少女游戏”（泣きゲー）闻名。Key社多被通称为“键”，而Key的粉丝则被称为“键っ子”。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"Key"}],"entry_key":{"kind":"person","namespace":"bangumi.person","value":"47"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912075","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912075","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"person"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"exact","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912075","original":"Key是Visual Art's旗下的一个游戏品牌，主要产品线集中在美少女游戏（含十八禁游戏）。著名作品有Kanon、AIR、CLANNAD。三作皆以“催泪美少女游戏”（泣きゲー）闻名。Key社多被通称为“键”，而Key的粉丝则被称为“键っ子”。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"Key"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1009706","source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","text":"47"}],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1009706","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1009706","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"47"}],"entry_key":{"kind":"person","namespace":"bangumi.person","value":"98614"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1009706","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1009706","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"person"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"alias","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1009706","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"47"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:44","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:44","original":"日本BANPRESTO日前在官方网站正式上公布了这款移植版S·RPG战略角色扮演游戏：《超级机器人大战 A 携带版》（Super Robot Taisen A Portable）将再次推出PSP版的好消息。官方同时也放出了游戏的最新情报和画面，供玩家参考。本作目前预定2008年6月19日发售，普通版售价为6,615日元（含税）。\r\n\r\n《超级机器人大战 A 携带版》是以 2001 年 9 月份在 GBA - Game Boy Advance上推出的《超级机器人大战 A》为基础所重制的移植版。PSP版将承袭原作内容，画面彻底翻新为 PS2 家用平台等级的华丽机体动态与角色特写演出，并追加原作所没有的战斗场面角色语音。游戏将完整收录原作来自 BANPRESTO 原创以及 21 部机器人动画作品的机体与角色。系统部分承袭原作并加以强化，加入会影响支持攻击、防御的“信赖度”，可自由替角色更换技能的“技能强化零件”等新要素。采 2D 地图接口，并具备各种便利的贴心设计。\r\n\r\n地图画面可透过模拟游戏杆自由缩放，让玩家调整成最适合自己的大小。按PSP上的“□键”可切换战斗画面显示方式，包括“4:3”的原始画面、“16:9”的全屏幕非等比例放大画面，以及“16:9”横向等比例放大画面（上下画面会被切除一部分）。精神指令字段除了驾驶员自己的指令之外，还会把其它驾驶员的支持指令如“信赖”等一并显示出来，便利玩家直接使用。\r\n\r\n※此次PSP版《超级机器人大战 A 携带版》参战作品名单如下：\r\n\r\n《机动战舰 NADESICO》；\r\n《机动战士高达》；\r\n《机动战士 Z 高达》；\r\n《机动战士高达 ZZ》；\r\n《机动战士高达 0083 星尘纪录》；\r\n《机动战士高达 夏亚的复仇》；\r\n《机动武斗传 G 高达》；\r\n《新机动战记高达 W 无尽的华尔兹》；\r\n《机动战士高达 第 08 MS 小队》；\r\n《无敌超人桑波特 3》；\r\n《无敌钢人岱坦 3》；\r\n《机甲战记龙骑兵》；\r\n《无敌铁金刚》；\r\n《大魔神》；\r\n《UFO 机器人金刚战神》；\r\n《盖特机器人》；\r\n《盖特机器人 G》；\r\n《真·盖特机器人》；（原作漫画版）\r\n《超电磁机器人孔=== 广告词语自动过滤 ===拉 V》；\r\n《超电磁魔神波罗 5 号》；\r\n《斗将戴摩斯》；\r\n《BANPRESTO》 原创机体等。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"スーパーロボット大戦A ポータブル"}],"entry_key":{"kind":"subject","namespace":"bangumi.subject","value":"47"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:44","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:44","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"subject"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"exact","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:44","original":"日本BANPRESTO日前在官方网站正式上公布了这款移植版S·RPG战略角色扮演游戏：《超级机器人大战 A 携带版》（Super Robot Taisen A Portable）将再次推出PSP版的好消息。官方同时也放出了游戏的最新情报和画面，供玩家参考。本作目前预定2008年6月19日发售，普通版售价为6,615日元（含税）。\r\n\r\n《超级机器人大战 A 携带版》是以 2001 年 9 月份在 GBA - Game Boy Advance上推出的《超级机器人大战 A》为基础所重制的移植版。PSP版将承袭原作内容，画面彻底翻新为 PS2 家用平台等级的华丽机体动态与角色特写演出，并追加原作所没有的战斗场面角色语音。游戏将完整收录原作来自 BANPRESTO 原创以及 21 部机器人动画作品的机体与角色。系统部分承袭原作并加以强化，加入会影响支持攻击、防御的“信赖度”，可自由替角色更换技能的“技能强化零件”等新要素。采 2D 地图接口，并具备各种便利的贴心设计。\r\n\r\n地图画面可透过模拟游戏杆自由缩放，让玩家调整成最适合自己的大小。按PSP上的“□键”可切换战斗画面显示方式，包括“4:3”的原始画面、“16:9”的全屏幕非等比例放大画面，以及“16:9”横向等比例放大画面（上下画面会被切除一部分）。精神指令字段除了驾驶员自己的指令之外，还会把其它驾驶员的支持指令如“信赖”等一并显示出来，便利玩家直接使用。\r\n\r\n※此次PSP版《超级机器人大战 A 携带版》参战作品名单如下：\r\n\r\n《机动战舰 NADESICO》；\r\n《机动战士高达》；\r\n《机动战士 Z 高达》；\r\n《机动战士高达 ZZ》；\r\n《机动战士高达 0083 星尘纪录》；\r\n《机动战士高达 夏亚的复仇》；\r\n《机动武斗传 G 高达》；\r\n《新机动战记高达 W 无尽的华尔兹》；\r\n《机动战士高达 第 08 MS 小队》；\r\n《无敌超人桑波特 3》；\r\n《无敌钢人岱坦 3》；\r\n《机甲战记龙骑兵》；\r\n《无敌铁金刚》；\r\n《大魔神》；\r\n《UFO 机器人金刚战神》；\r\n《盖特机器人》；\r\n《盖特机器人 G》；\r\n《真·盖特机器人》；（原作漫画版）\r\n《超电磁机器人孔=== 广告词语自动过滤 ===拉 V》；\r\n《超电磁魔神波罗 5 号》；\r\n《斗将戴摩斯》；\r\n《BANPRESTO》 原创机体等。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"スーパーロボット大戦A ポータブル"}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[],"citations":[{"evidence_id":"tag_wiki-complete-a2eb055c578d:a2eb055c578d37e82b71df787cd11b7616e77768eb319cf0839831cfdbb28fef:line:675","source_id":"tag_wiki-complete-a2eb055c578d"}],"descriptions":[],"entry_key":{"kind":"tag","namespace":"local.tag_aggregate","value":"47"},"evidence_id":"tag_wiki-complete-a2eb055c578d:a2eb055c578d37e82b71df787cd11b7616e77768eb319cf0839831cfdbb28fef:line:675","identity_evidence":[{"evidence_id":"tag_wiki-complete-a2eb055c578d:a2eb055c578d37e82b71df787cd11b7616e77768eb319cf0839831cfdbb28fef:line:675","locator":null,"source_id":"tag_wiki-complete-a2eb055c578d","status":"source_backed","type":"tag"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"exact","matched_documents":[],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"tag_wiki-complete-a2eb055c578d"}],"canonical":null,"citations":[],"contract_version":"2","descriptions":[],"entry_key":null,"query":"47","relations":[],"response_version":"3","snapshot":"373fcb69731db877929c102b75