plete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15472","original":"A character from the [[Macross]] series. She first appeared in the [[Macross Frontier]] TV series from 2008. \r\n\r\n[b]Grace O'Connor[/b] is [[Sheryl Nome]]'s manager. Like many people from Macross Galaxy, Grace is also a [[cyborg]]. \r\n\r\n\r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"grace_o'connor"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"21061"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15472","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15472","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15472","original":"A character from the [[Macross]] series. She first appeared in the [[Macross Frontier]] TV series from 2008. \r\n\r\n[b]Grace O'Connor[/b] is [[Sheryl Nome]]'s manager. Like many people from Macross Galaxy, Grace is also a [[cyborg]]. \r\n\r\n\r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"grace_o'connor"}],"score":-25.66899668547311,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15471","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15471","original":"A character from the [[Macross]] series. She first appeared in the [[Macross Frontier]] TV series from 2008. \r\n\r\n[b]Sheryl Nome[/b] is a famous songstress who grew up in the Macross Galaxy colony fleet. She probably is [[Mao Nome]]'s granddaughter and thus has [[mayan_(macross)|Mayan]]/[[Protoculture]] genes in her. \r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"sheryl_nome"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"21060"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15471","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15471","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15471","original":"A character from the [[Macross]] series. She first appeared in the [[Macross Frontier]] TV series from 2008. \r\n\r\n[b]Sheryl Nome[/b] is a famous songstress who grew up in the Macross Galaxy colony fleet. She probably is [[Mao Nome]]'s granddaughter and thus has [[mayan_(macross)|Mayan]]/[[Protoculture]] genes in her. \r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"sheryl_nome"}],"score":-25.43701139357512,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15468","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15468","original":"A fictional [[space]] [[fleet]] from the [[MACROSS]] series. It first appeared in the [[Macross Frontier]] anime TV series from 2008.\r\n\r\nThe [b]Macross Galaxy Fleet[/b] is a New [[U.N. Spacy]] ([[N.U.N.S.]]) colonization fleet where new technologies are being constantly developed and tested. \r\n\r\nIt is the only fleet where cybernetic implants and [[cyborgs]] are legal during the events of Macross Frontier.\r\n\r\nh4. See also\r\n\r\n* [[Battle Galaxy]]\r\n* [[VF-27]]\r\n* [[V-9]]\r\n* [[Brera Sterne]]\r\n* [[Sheryl Nome]]\r\n* [[Grace O'Connor]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"macross_galaxy"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"21057"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15468","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15468","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15468","original":"A fictional [[space]] [[fleet]] from the [[MACROSS]] series. It first appeared in the [[Macross Frontier]] anime TV series from 2008.\r\n\r\nThe [b]Macross Galaxy Fleet[/b] is a New [[U.N. Spacy]] ([[N.U.N.S.]]) colonization fleet where new technologies are being constantly developed and tested. \r\n\r\nIt is the only fleet where cybernetic implants and [[cyborgs]] are legal during the events of Macross Frontier.\r\n\r\nh4. See also\r\n\r\n* [[Battle Galaxy]]\r\n* [[VF-27]]\r\n* [[V-9]]\r\n* [[Brera Sterne]]\r\n* [[Sheryl Nome]]\r\n* [[Grace O'Connor]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"macross_galaxy"}],"score":-25.365742438401917,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15470","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15470","original":"A character from the [[Macross]] series. He first appeared in the [[Macross Frontier]] TV series from 2008.\r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"brera_sterne"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"21059"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15470","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15470","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15470","original":"A character from the [[Macross]] series. He first appeared in the [[Macross Frontier]] TV series from 2008.\r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"brera_sterne"}],"score":-24.605718848480656,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15467","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15467","original":"A [[mecha]] from the [[Macross]] series. It first appeared in the [[Macross Frontier]] TV series.\r\n\r\nThe [b]Ghost V-9[/b] is an advanced unmanned fighter used by the New [[U.N. Spacy]] ([[N.U.N.S.]]) [[Macross Galaxy]] fleet. Its design was based on the [[X-9]] Ghost fighter from [[Macross Plus]].\r\n\r\nh4. See also\r\n\r\n* [[Ghost Drone]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"v-9"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"21056"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15467","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15467","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:15467","original":"A [[mecha]] from the [[Macross]] series. It first appeared in the [[Macross Frontier]] TV series.\r\n\r\nThe [b]Ghost V-9[/b] is an advanced unmanned fighter used by the New [[U.N. Spacy]] ([[N.U.N.S.]]) [[Macross Galaxy]] fleet. Its design was based on the [[X-9]] Ghost fighter from [[Macross Plus]].\r\n\r\nh4. See also\r\n\r\n* [[Ghost Drone]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"v-9"}],"score":-22.449926149082753,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:11020","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:11020","original":"Ancient humanoid [[alien]] race frequently mentioned in the [[MACROSS]] [[mecha]] anime series. \r\n\r\nIt was first referenced in [[choujikuu_yousai_macross|The Super Dimension Fortress Macross]] TV series from 1982.\r\n\r\nThe [b]Protoculture[/b] created a Stellar Republic that controlled much of the [[Milky Way]] [[Galaxy]] 500,000 years ago. They are responsible for the creation of the Zentradi, the Meltrandi, the Protodeviln, the Zolan and the Human race. \r\n\r\nThis advanced civilization also came into contact with the Vajra race and obtained technology from it.\r\n\r\nThe symbol of the Protoculture is usually depicted in the Macross series as a red or yellow spiral, perhaps to symbolize the shape of the galaxy they once ruled.\r\n\r\nAccording to its creators, the humanoid alien civilization from the anime film [[Honneamise No Tsubasa]] are supposed to be their interpretation of the Protoculture from [i]Macross[/i].\r\n\r\nh4. See also\r\n* [[Mayan (macross)|]]\r\n* [[Zentradi]]\r\n* [[Meltrandi]]\r\n* [[Protodeviln]]\r\n* [[Birdhuman]]\r\n* [[Vajra (macross)|]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"protoculture"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"16417"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:11020","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:11020","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:11020","original":"Ancient humanoid [[alien]] race frequently mentioned in the [[MACROSS]] [[mecha]] anime series. \r\n\r\nIt was first referenced in [[choujikuu_yousai_macross|The Super Dimension Fortress Macross]] TV series from 1982.\r\n\r\nThe [b]Protoculture[/b] created a Stellar Republic that controlled much of the [[Milky Way]] [[Galaxy]] 500,000 years ago. They are responsible for the creation of the Zentradi, the Meltrandi, the Protodeviln, the Zolan and the Human race. \r\n\r\nThis advanced civilization also came into contact with the Vajra race and obtained technology from it.\r\n\r\nThe symbol of the Protoculture is usually depicted in the Macross series as a red or yellow spiral, perhaps to symbolize the shape of the galaxy they once ruled.\r\n\r\nAccording to its creators, the humanoid alien civilization from the anime film [[Honneamise No Tsubasa]] are supposed to be their interpretation of the Protoculture from [i]Macross[/i].\r\n\r\nh4. See also\r\n* [[Mayan (macross)|]]\r\n* [[Zentradi]]\r\n* [[Meltrandi]]\r\n* [[Protodeviln]]\r\n* [[Birdhuman]]\r\n* [[Vajra (macross)|]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"protoculture"}],"score":-22.128487916656034,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:9852","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:9852","original":"A [[mecha]] from the [[MACROSS]] universe. The [b]VF-27 Lucifer[/b] is an advanced [[variable fighter]] that first appeared in the [[Macross Frontier]] TV series.\r\n\r\nThis [[variable fighter]] is so fast and agile that only [[cyborg]]s can tolerate its maximum speeds.\r\n\r\nIt is the mecha of choice for [[Brera Sterne]].\r\n\r\nIt was designed by [[Kawamori Shouji]].\r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"vf-27"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"15185"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:9852","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:9852","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:9852","original":"A [[mecha]] from the [[MACROSS]] universe. The [b]VF-27 Lucifer[/b] is an advanced [[variable fighter]] that first appeared in the [[Macross Frontier]] TV series.\r\n\r\nThis [[variable fighter]] is so fast and agile that only [[cyborg]]s can tolerate its maximum speeds.\r\n\r\nIt is the mecha of choice for [[Brera Sterne]].\r\n\r\nIt was designed by [[Kawamori Shouji]].\r\n\r\nh4. See also\r\n\r\n* [[Macross Galaxy]]","response_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","title":"vf-27"}],"score":-21.319629704454897,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"danbooru-complete-a26a3829dd42"},{"aliases":[],"citations":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:10569","source_id":"danbooru-complete-a26a3829dd42"}],"descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:10569","original":"A transformation mode first seen in the [[SDF-1]] [[spacecraft]] from the anime [[Choujikuu Yousai Macross]].\r\n\r\nAfter a 15 minute modular transformation the ship is modified to look like a giant [[robot]] and be able to fire its main weapon. It is also the only mode where the ship is able to perform the [[Daedalus Attack]].\r\n\r\nThis mode has been used also in other spaceships that have appeared in the [[Macross]] series.\r\n\r\nh4. Spaceships That Feature This Mode: \r\n\r\n* SDF-1 Macross ([b][i]The Super Dimension Fortress Macross[/i][/b])\r\n* [[Battle 7]] ([b][i][[Macross 7]][/i][/b])\r\n* [[Battle Frontier]] ([b][i][[Macross Frontier]][/i][/b])\r\n* [[Battle Galaxy]] ([b][i]Macross Frontier[/i][/b])\r\n* [[Macross Quarter]] ([b][i]Macross Frontier[/i][/b])\r\n* [[Macross Elysion]] ([b][i][[Macross Delta]][/i][/b])","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"storm_attacker"}],"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"15947"},"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:10569","identity_evidence":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:10569","locator":null,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","type":"page"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_document