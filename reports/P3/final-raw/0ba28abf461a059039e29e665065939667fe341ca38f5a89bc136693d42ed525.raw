072f7cf3e3ee4e558fb7421aadf9c9b600b8303b8f9c61cf3da9871018ac99d:line:1","field":"raw_attributes","source_id":"moegirl-complete-5072f7cf3e3e","status":"source_backed"},{"evidence_id":"moegirl-complete-5072f7cf3e3e:5072f7cf3e3ee4e558fb7421aadf9c9b600b8303b8f9c61cf3da9871018ac99d:line:1","field":"raw_subject_categories","source_id":"moegirl-complete-5072f7cf3e3e","status":"source_backed"},{"evidence_id":"moegirl-complete-5072f7cf3e3e:5072f7cf3e3ee4e558fb7421aadf9c9b600b8303b8f9c61cf3da9871018ac99d:line:1","field":"raw_cv_names","source_id":"moegirl-complete-5072f7cf3e3e","status":"source_backed"},{"evidence_id":"moegirl-complete-5072f7cf3e3e:5072f7cf3e3ee4e558fb7421aadf9c9b600b8303b8f9c61cf3da9871018ac99d:line:1","field":"raw_gender","source_id":"moegirl-complete-5072f7cf3e3e","status":"source_backed"}],"source_fields_truncated":[],"source_id":"moegirl-complete-5072f7cf3e3e"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:715056","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:715056","original":"联盟里有很多战士因其神力、精明或精湛的技能而成为大人物,其他战士却只想保住小命。曾是诺克萨斯一名伟大士兵的首领之傲厄加特，可能就属于后者。厄加特喜欢潜伏到敌人的主战部队里，然后在敌人的军队中制造混乱，他经常在此过程中受重伤。\r\n当厄加特的身体已无法再承受更多伤害时，残废的他被委派为诺克萨斯高级刽子手。这时候的他，双手残废，举步为难。镰刀型的假肢让他得以从事这份血腥的工作本应是厄加特最光荣的时刻，最终却让他走到了尽头。因为厄加特有军队背景，所以他经常随同派遣队到其他地方执行判决。在伏击敌方军队后，德玛西亚的王子（皇子）——嘉文四世落入了厄加特所在的分队中。因为德玛西亚离诺克萨斯很远，把嘉文四世运送回去领功的风险很大。为了不冒险，厄加特决定就地解决他们的俘虏。\r\n在千钧一发之际，德玛西亚之力——盖伦带领的无畏先锋出现了，厄加特被前往救援嘉文四世的士兵砍成两半。为了表彰厄加特的贡献，刽子手的残骸被送回阴冷的研究院进行复活。\r\n厄加特留下了一生受尽创伤而残缺不堪的尸体，这也证明了当时的巫师技艺存在问题。祖安城的普通学者斯坦维克·彼利教授提出了解决方案。在彼利的实验室里，厄加特拥有了新的却非常可怕的身体。现在他已经变成机器和肉身完美结合的恐怖魔兽。厄加特来到英雄联盟，寻找杀死他的凶手。他那金属静脉里满满的都是巫术。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"Urgot"}],"entry_key":{"kind":"character","namespace":"bangumi.character","value":"26151"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:715056","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:715056","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"character"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:715056","original":"联盟里有很多战士因其神力、精明或精湛的技能而成为大人物,其他战士却只想保住小命。曾是诺克萨斯一名伟大士兵的首领之傲厄加特，可能就属于后者。厄加特喜欢潜伏到敌人的主战部队里，然后在敌人的军队中制造混乱，他经常在此过程中受重伤。\r\n当厄加特的身体已无法再承受更多伤害时，残废的他被委派为诺克萨斯高级刽子手。这时候的他，双手残废，举步为难。镰刀型的假肢让他得以从事这份血腥的工作本应是厄加特最光荣的时刻，最终却让他走到了尽头。因为厄加特有军队背景，所以他经常随同派遣队到其他地方执行判决。在伏击敌方军队后，德玛西亚的王子（皇子）——嘉文四世落入了厄加特所在的分队中。因为德玛西亚离诺克萨斯很远，把嘉文四世运送回去领功的风险很大。为了不冒险，厄加特决定就地解决他们的俘虏。\r\n在千钧一发之际，德玛西亚之力——盖伦带领的无畏先锋出现了，厄加特被前往救援嘉文四世的士兵砍成两半。为了表彰厄加特的贡献，刽子手的残骸被送回阴冷的研究院进行复活。\r\n厄加特留下了一生受尽创伤而残缺不堪的尸体，这也证明了当时的巫师技艺存在问题。祖安城的普通学者斯坦维克·彼利教授提出了解决方案。在彼利的实验室里，厄加特拥有了新的却非常可怕的身体。现在他已经变成机器和肉身完美结合的恐怖魔兽。厄加特来到英雄联盟，寻找杀死他的凶手。他那金属静脉里满满的都是巫术。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","title":"Urgot"}],"score":-15.413471347576857,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754115","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754115","original":"白色彗星帝国加特兰蒂斯的女宰相","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"シファル・サーベラー"}],"entry_key":{"kind":"character","namespace":"bang