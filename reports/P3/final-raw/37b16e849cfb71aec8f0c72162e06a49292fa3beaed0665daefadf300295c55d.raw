e_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1287440","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1287440","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1287440"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"626569"},"locator":null,"descriptions":[{"title":"100","original":"番組内容\r\n    ２００３年度放送の連続テレビ小説。昭和の大阪を舞台に、製パン店の父と母、そして４人の娘たちが繰り広げる夢と笑いと涙の日々を、懐かしの昭和歌謡にのせお送りする。\r\n\r\n詳細\r\n    春子（紺野まひる）は真剣な表情で、岡谷（川岡大次郎）との交際を認めてほしいと照子（浅野ゆう子）に訴える。彼がいればスケートももっと頑張れると言うのだ。照子は「もう勝手にすればいい」としぶしぶ認める。一週間後、宝塚音楽学校では本科生（２年生）の卒業記念文化祭が行われる。冬子（石原さとみ）は先輩・京子（竹中絵里）の手伝いをしつつ、予科生（１年生）として舞台に立ち、生まれて初めての本番の緊張感を味わう。 \r\n\r\n出演者ほか\r\n    【原作】なかにし礼，【出演】石原さとみ，岸谷五朗，紺野まひる，上野樹里，錦戸亮，川岡大次郎，橘実里，竹中絵里，絵沢萌子，大村崑，浅野ゆう子，【脚本】大森寿美男，【音楽】宮川泰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1607320","status":"source_backed"}],"matched_documents":[{"title":"100","original":"番組内容\r\n    ２００３年度放送の連続テレビ小説。昭和の大阪を舞台に、製パン店の父と母、そして４人の娘たちが繰り広げる夢と笑いと涙の日々を、懐かしの昭和歌謡にのせお送りする。\r\n\r\n詳細\r\n    春子（紺野まひる）は真剣な表情で、岡谷（川岡大次郎）との交際を認めてほしいと照子（浅野ゆう子）に訴える。彼がいればスケートももっと頑張れると言うのだ。照子は「もう勝手にすればいい」としぶしぶ認める。一週間後、宝塚音楽学校では本科生（２年生）の卒業記念文化祭が行われる。冬子（石原さとみ）は先輩・京子（竹中絵里）の手伝いをしつつ、予科生（１年生）として舞台に立ち、生まれて初めての本番の緊張感を味わう。 \r\n\r\n出演者ほか\r\n    【原作】なかにし礼，【出演】石原さとみ，岸谷五朗，紺野まひる，上野樹里，錦戸亮，川岡大次郎，橘実里，竹中絵里，絵沢萌子，大村崑，浅野ゆう子，【脚本】大森寿美男，【音楽】宮川泰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1607320","status":"source_backed"}],"aliases":[{"text":"100","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1607320","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1607320","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1607320","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1607320"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"746824"},"locator":null,"descriptions":[{"title":"100","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1723782","status":"source_backed"}],"matched_documents":[{"title":"100","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1723782","status":"source_backed"}],"aliases":[{"text":"100","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1723782","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1723782","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1723782","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1723782"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"897217"},"locator":null,"descriptions":[{"title":"100","original":"番組内容\r\n    主人公おしんの明治から昭和に至る激動の生涯を描き、国内のみならず世界各地で大きな感動を呼んだ１９８３年度連続テレビ小説。全２９７回を１年にわたりアンコール放送。\r\n\r\n詳細\r\n    おしん（田中裕子）のところに健（ガッツ石松）から、いつでも露店商として商売できるようになったという知らせがあった。おしんは、健に丁寧にお礼を言って、さっそくその夜から露店を出した。一日も早く在庫を処分して新しい仕事の資金にしたかったのである。おしんのねらい通り、洋服布地のたたき売りは、評判になって大勢の客を集めて、大成功をおさめた。おしんは、在庫の布地を１０日余りで売りさばいたのである。\r\n\r\n出演者ほか\r\n    【作】橋田壽賀子，【出演】田中裕子，並樹史朗，今福将雄，ガッツ石松，大橋吾郎，乙羽信子，【語り】奈良岡朋子，【音楽】坂田晃一","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1871130","status":"source_backed"}],"matched_documents":[{"title":"100","original":"番組内容\r\n    主人公おしんの明治から昭和に至る激動の生涯を描き、国内のみならず世界各地で大きな感動を呼んだ１９８３年度連続テレビ小説。全２９７回を１年にわたりアンコール放送。\r\n\r\n詳細\r\n    おしん（田中裕子）のところに健（ガッツ石松）から、いつでも露店商として商売できるようになったという知らせがあった。おしんは、健に丁寧にお礼を言って、さっそくその夜から露店を出した。一日も早く在庫を処分して新しい仕事の資金にしたかったのである。おしんのねらい通り、洋服布地のたたき売りは、評判になって大勢の客を集めて、大成功をおさめた。おしんは、在庫の布地を１０日余りで売りさばいたのである。\r\n\r\n出演者ほか\r\n    【作】橋田壽賀子，【出演】田中裕子，並樹史朗，今福将雄，ガッツ石松，大橋吾郎，乙羽信子，【語り】奈良岡朋子，【音楽】坂田晃一","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1871130","status":"source_backed"}],"aliases":[{"text":"100","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1871130","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1871130","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1871130","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1871130"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"969991"},"locator":null,"descriptions":[{"title":"100","original":"番組内容\r\n    福島県相馬の“はね駒（こんま）”（おてんば娘）りんが、仙台の女学校を卒業後上京、結婚・出産を経て女性新聞記者の草分けとなる物語。１９８６年放送の連続テレビ小説。\r\n\r\n詳細\r\n    りん（斉藤由貴）と源造（渡辺謙）の新婚生活４日目の夜、なかなか源造は帰ってこなかった。ようやく帰宅した源造は、３人も客を連れていて、家でまだ酒を飲むという。若社長の西岡晋作（綾田俊樹）は源造の大事なお得意先だというが、泥酔していていきなりりんの手を握る始末。りんは不愉快な気分を抑えて源造のため、いい妻を演じようとするのだが…。\r\n\r\n出演者ほか\r\n    【作】寺内小春，【出演】斉藤由貴，樹木希林，渡辺謙，小林稔侍，綾田俊樹，岡部征純，麻茶れい，丹阿弥谷津子，山内明，【音楽】三枝成彰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1942508","status":"source_backed"}],"matched_documents":[{"title":"100","original":"番組内容\r\n    福島県相馬の“はね駒（こんま）”（おてんば娘）りんが、仙台の女学校を卒業後上京、結婚・出産を経て女性新聞記者の草分けとなる物語。１９８６年放送の連続テレビ小説。\r\n\r\n詳細\r\n    りん（斉藤由貴）と源造（渡辺謙）の新婚生活４日目の夜、なかなか源造は帰ってこなかった。ようやく帰宅した源造は、３人も客を連れていて、家でまだ酒を飲むという。若社長の西岡晋作（綾田俊樹）は源造の大事なお得意先だというが、泥酔していていきなりりんの手を握る始末。りんは不愉快な気分を抑えて源造のため、いい妻を演じようとするのだが…。\r\n\r\n出演者ほか\r\n    【作】寺内小春，【出演】斉藤由貴，樹木希林，渡辺謙，小林稔侍，綾田俊樹，岡部征純，麻茶れい，丹阿弥谷津子，山内明，【音楽】三枝成彰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1942508","status":"source_backed"}],"aliases":[{"text":"100","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1942508","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1942508","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1942508","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1942508"}]},{"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"100"},"locator":null,"descriptions":[{"title":"skuld_(aa_megami-sama)","original":"Skuld is a character from the [[Aa Megami-sama]] anime and manga. Like her sisters, she's a 10-dimensional entity that is able to manifest and survive in our 4-dimensional universe thanks to her emblem control program (that is located on her forehead).\r\n\r\nIf she uses too much energy (or if the functioning of her emblem control program is disrupted), she can use ice-cream (preferably the brand 131) as an alternative energy source.","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:36","status":"source_backed"}],"matched_documents":[{"title":"skuld_(aa_megami-sama)","original":"Skuld is a character from the [[Aa Megami-sama]] anime and manga. Like her sisters, she's a 10-dimensional entity that is able to manifest and survive in our 4-dimensional universe thanks to her emblem control program (that is located on her forehead).\r\n\r\nIf she uses too much energy (or if the functioning of her emblem control program is disrupted), she can use ice-cream (preferably the brand 131) as an alternative energy source.","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:36","status":"source_backed"}],"aliases":[],"identity_evidence":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:36","status":"source_backed","type":"page","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"exact","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:36","citations":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:36"}]},{"entry_key":{"kind":"person","namespace":"bangumi.person","value":"100"},"locator":null,"descriptions":[{"title":"渡辺信一郎","original":"アニメ演出家、監督。\r\n\r\n学生時代は映画青年だったというが、実写映画の世界は助監督での下積みが長いということでアニメ業界入り。これには、1984年、19歳のときに宮崎駿監督の『風の谷のナウシカ』、押井守監督の『うる星やつら2 ビューティフル・ドリーマー』の2本のアニメ映画を見たことも大きかったという。\r\n\r\nアニメ制作会社サンライズで制作進行を経て、演出家へ。1994年のOVA『マクロスプラス』が初監督作品であり、この作品に参加したスタッフが再び集った1998年のテレビアニメ『カウボーイビバップ』は、その年最大の話題作の一つとなり、渡辺の出世作にもなった。音楽が趣味と言うだけあって、音響に対するこだわりが強い。『カウボーイビバップ』ではジャズ、『サムライチャンプルー』ではヒップホップを取り入れた他、アニメ映画『マインド・ゲーム』で音楽プロデューサーとしてもデビュー。以降の作品でも音楽制作面で積極的に関わる。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912128","status":"source_backed"}],"matched_documents":[{"title":"渡辺信一郎","original":"アニメ演出家、監督。\r\n\r\n学生時代は映画青年だったというが、実写映画の世界は助監督での下積みが長いということでアニメ業界入り。これには、1984年、19歳のときに宮崎駿監督の『風の谷のナウシカ』、押井守監督の『うる星やつら2 ビューティフル・ドリーマー』の2本のアニメ映画を見たことも大きかったという。\r\n\r\nアニメ制作会社サンライズで制作進行を経て、演出家へ。1994年のOVA『マクロスプラス』が初監督作品であり、この作品に参加したスタッフが再び集った1998年のテレビアニメ『カウボーイビバップ』は、その年最大の話題作の一つとなり、渡辺の出世作にもなった。音楽が趣味と言うだけあって、音響に対するこだわりが強い。『カウボーイビバップ』ではジャズ、『サムライチャンプルー』ではヒップホップを取り入れた他、アニメ映画『マインド・ゲーム』で音楽プロデューサーとしてもデビュー。以降の作品でも音楽制作面で積極的に関わる。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912128","status":"source_backed"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912128","status":"source_backed","type":"person","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"exact","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5