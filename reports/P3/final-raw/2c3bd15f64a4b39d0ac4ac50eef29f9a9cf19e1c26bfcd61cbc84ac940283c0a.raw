e5be40bd7de2ff8343dcc4:line:1523541","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1523541","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1523541","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1523541","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1523541"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"662680"},"locator":null,"descriptions":[{"title":"11","original":"サイレンとマジリベンジ\r\n\r\n島崎（野間口徹）やメンバーから説得されたユーヤ（大東駿介）は、吉光（片岡鶴太郎）への復讐は諦めたと宣言する。しかしユーヤが自分の意志を簡単に曲げないことを知っているメンバーらは、その言葉を信じ切れない。一方、何も知らないタツヤ（中村蒼）は、憧れである吉光の都知事就任パーティーに出席して浮かれていたが……。ユーヤはピコ（福地桃子）からカードキーを受け取り、パーティー開始直前に吉光の部屋に乗り込んだ。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1641875","status":"source_backed"}],"matched_documents":[{"title":"11","original":"サイレンとマジリベンジ\r\n\r\n島崎（野間口徹）やメンバーから説得されたユーヤ（大東駿介）は、吉光（片岡鶴太郎）への復讐は諦めたと宣言する。しかしユーヤが自分の意志を簡単に曲げないことを知っているメンバーらは、その言葉を信じ切れない。一方、何も知らないタツヤ（中村蒼）は、憧れである吉光の都知事就任パーティーに出席して浮かれていたが……。ユーヤはピコ（福地桃子）からカードキーを受け取り、パーティー開始直前に吉光の部屋に乗り込んだ。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1641875","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1641875","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1641875","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1641875","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1641875"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"833367"},"locator":null,"descriptions":[{"title":"11","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1808320","status":"source_backed"}],"matched_documents":[{"title":"11","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1808320","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1808320","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1808320","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1808320","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1808320"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"892873"},"locator":null,"descriptions":[{"title":"11","original":"GRANDSLAM達成者\r\n\r\n    山中健碁＆\r\n    福田凌太郎\r\n    挑戦ジャンル\r\n        超難読漢字\r\n\r\n著名人挑戦者\r\n\r\n    土佐兄弟\r\n    DJ KOO＆\r\n    マーク・パンサー\r\n    りゅうちぇる＆\r\n    比花知春\r\n\r\n解説ゲスト\r\n\r\n    小山慶一郎（NEWS）\r\n    柳原可奈子","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1866850","status":"source_backed"}],"matched_documents":[{"title":"11","original":"GRANDSLAM達成者\r\n\r\n    山中健碁＆\r\n    福田凌太郎\r\n    挑戦ジャンル\r\n        超難読漢字\r\n\r\n著名人挑戦者\r\n\r\n    土佐兄弟\r\n    DJ KOO＆\r\n    マーク・パンサー\r\n    りゅうちぇる＆\r\n    比花知春\r\n\r\n解説ゲスト\r\n\r\n    小山慶一郎（NEWS）\r\n    柳原可奈子","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1866850","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1866850","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1866850","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1866850","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1866850"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"904613"},"locator":null,"descriptions":[{"title":"11","original":"魔祓いで生じた背中の痛みを和らげるため、郷内が湯に浸かっていると、両膝の間から月川涙の頭が出てくる。図らずも厄災に巻き込まれた郷内は、美琴を呼び出し、暴走するタルパの危険性を説く。そして二人は、月川涙の創造主がいる開かずの地下室へと急ぐ。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1878362","status":"source_backed"}],"matched_documents":[{"title":"11","original":"魔祓いで生じた背中の痛みを和らげるため、郷内が湯に浸かっていると、両膝の間から月川涙の頭が出てくる。図らずも厄災に巻き込まれた郷内は、美琴を呼び出し、暴走するタルパの危険性を説く。そして二人は、月川涙の創造主がいる開かずの地下室へと急ぐ。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1878362","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1878362","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1878362","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1878362","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1878362"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"923557"},"locator":null,"descriptions":[{"title":"11","original":"「3人でこうして寝るのも今日で最後か…」\r\n12月24日、クリスマス・イブの夜に長男・唯一（黒羽麻璃央）がつぶやく。\r\n次男・天授（鳥越裕貴）は就職のため、三男・ガイ（眞嶋秀斗）は役者になるため、それぞれ東京を離れることに…。\r\n弟2人の門出を祝いたいけれど、一人でゆっくり寝られると強がってみるけれど、やっぱり一人で寝るのって寂しい！！物語は涙の最終回！\r\n他「一家に一人」など","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1897037","status":"source_backed"}],"matched_documents":[{"title":"11","original":"「3人でこうして寝るのも今日で最後か…」\r\n12月24日、クリスマス・イブの夜に長男・唯一（黒羽麻璃央）がつぶやく。\r\n次男・天授（鳥越裕貴）は就職のため、三男・ガイ（眞嶋秀斗）は役者になるため、それぞれ東京を離れることに…。\r\n弟2人の門出を祝いたいけれど、一人でゆっくり寝られると強がってみるけれど、やっぱり一人で寝るのって寂しい！！物語は涙の最終回！\r\n他「一家に一人」など","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1897037","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1897037","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1897037","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1897037","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1897037"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"940719"},"locator":null,"descriptions":[{"title":"11","original":"番組内容\r\n    福島県相馬の“はね駒（こんま）”（おてんば娘）りんが、仙台の女学校で英語を学び、結婚・出産を経て女性新聞記者の草分けとなる物語。１９８６年放送の連続テレビ小説。\r\n\r\n詳細\r\n    りん（斉藤由貴）は見知らぬ男・小野寺源造（渡辺謙）に水くみを頼みこむ。隣に住む中河鶴次（矢崎滋）の妻・千代（岡本茉利）が産気づいたのだ。源造は、さっきまで鶴次の２人の幼子の子守を押しつけられへとへと。自分は客だと伝えるが、りんは全く信じようとしない。これが、りんと源造の出会いだった。\r\n\r\n出演者ほか\r\n    【作】寺内小春，【出演】斉藤由貴，樹木希林，渡辺謙，小林稔侍，矢崎滋，綿引勝彦，岡本茉利，花沢徳衛，ガッツ石松，丹阿弥谷津子，山内明，【語り】細川俊之，【音楽】三枝成彰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913648","status":"source_backed"}],"matched_documents":[{"title":"11","original":"番組内容\r\n    福島県相馬の“はね駒（こんま）”（おてんば娘）りんが、仙台の女学校で英語を学び、結婚・出産を経て女性新聞記者の草分けとなる物語。１９８６年放送の連続テレビ小説。\r\n\r\n詳細\r\n    りん（斉藤由貴）は見知らぬ男・小野寺源造（渡辺謙）に水くみを頼みこむ。隣に住む中河鶴次（矢崎滋）の妻・千代（岡本茉利）が産気づいたのだ。源造は、さっきまで鶴次の２人の幼子の子守を押しつけられへとへと。自分は客だと伝えるが、りんは全く信じようとしない。これが、りんと源造の出会いだった。\r\n\r\n出演者ほか\r\n    【作】寺内小春，【出演】斉藤由貴，樹木希林，渡辺謙，小林稔侍，矢崎滋，綿引勝彦，岡本茉利，花沢徳衛，ガッツ石松，丹阿弥谷津子，山内明，【語り】細川俊之，【音楽】三枝成彰","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913648","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913648","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913648","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913648","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1913648"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"948875"},"locator":null,"descriptions":[{"title":"11","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1921716","status":"source_backed"}],"matched_documents":[{"title":"11","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1921716","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1921716","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1921716","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1921716","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1921716"}]},{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"982073"},"locator":null,"descriptions":[{"title":"11","original":"番組内容\r\n    “陸（おか）者”と“海者”が対立する港町での、しょうゆ醸造の旧家の娘・かをる（沢口靖子）と網元の跡取り息子の波乱万丈の愛の物語。１９８５年放送の連続テレビ小説。\r\n\r\n出演者ほか\r\n    【作】ジェームス三木，【出演】沢口靖子，川野太郎，柴田恭兵，明石家さんま，牟田悌三，鷲尾真知子，高橋珠美子，村田雄浩，葛西和雄，加賀まりこ，津川雅彦，【語り】葛西聖司，【音楽】池辺晋一郎 \r\n\r\n詳細\r\n    転んだかをる（沢口靖子）に声をかけたのは、夢にまで見た吉武惣吉（川野太郎）だった。惣吉に背負われて、この道がどこまでも続けばいいと思うかをる。家に帰ると心配したるい（加賀まりこ）と、黙って家を出たことについて口論になる。ある日、乗ってきた車がエンストして、久兵衛（津川雅彦）と梅木（柴田恭兵）が二人で車を押していると、弥太郎（明石家さんま）が通りかかり、手伝った縁で、入兆で世話になることになる。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954371","status":"source_backed"}],"matched_documents":[{"title":"11","original":"番組内容\r\n    “陸（おか）者”と“海者”が対立する港町での、しょうゆ醸造の旧家の娘・かをる（沢口靖子）と網元の跡取り息子の波乱万丈の愛の物語。１９８５年放送の連続テレビ小説。\r\n\r\n出演者ほか\r\n    【作】ジェームス三木，【出演】沢口靖子，川野太郎，柴田恭兵，明石家さんま，牟田悌三，鷲尾真知子，高橋珠美子，村田雄浩，葛西和雄，加賀まりこ，津川雅彦，【語り】葛西聖司，【音楽】池辺晋一郎 \r\n\r\n詳細\r\n    転んだかをる（沢口靖子）に声をかけたのは、夢にまで見た吉武惣吉（川野太郎）だった。惣吉に背負われて、この道がどこまでも続けばいいと思うかをる。家に帰ると心配したるい（加賀まりこ）と、黙って家を出たことについて口論になる。ある日、乗ってきた車がエンストして、久兵衛（津川雅彦）と梅木（柴田恭兵）が二人で車を押していると、弥太郎（明石家さんま）が通りかかり、手伝った縁で、入兆で世話になることになる。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954371","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954371","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954371","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954371","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1954371"}]},{"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"11"},"locator":null,"descriptions":[{"title":"touhou","original":"\"東方\" (Japanese for \"eastern\") \r\n\r\nA series of \"bullet hell\" vertical shooter games created by [[ZUN (artist)|]], featuring a large cast of girls and almost no male characters.\r\n\r\nTouhou first appeared on the NEC PC-9801 computers in its first five games between 1996 and 1998 before going into hiatus, during which time ZUN left his former team, Amusement Makers. These games make up the [[Touhou (PC-98)]] era. In 2002 he returned as the one-man doujin group [i]Team Shanghai Alice[/i] and released Touhou for Windows, thus exposing it to a larger audience. \r\n\r\nThe games themselves, mostly in the [[danmaku]] (\"bullet hell\") genre, are addictive and have acquired a large following. In particular, his original music is incredibly popular and is the subject of numerous doujin remix albums.\r\n\r\nCurrently Touhou has twenty mainstream danmaku shooter games, six danmaku spinoffs, six fighting spinoffs and an action spinoff, with the fighting games and action game made in collaboration with Tasogare Frontier. The series also has a number of supplementary materials including manga, short stories, fanbooks, and music CDs.\r\n\r\nThe backgrounds and personalities of its characters (the majority of which come from the Windows generation) are often expanded upon in doujins and, occasionally, ZUN canonizes some concepts. \r\n\r\nTouhou is also notable for being a [i]de facto[/i] open source franchise, in which ZUN allows various fan works such as doujinshi and video games to be published and sold with little to no licensing fees. This allowed the franchise to remain popular to this day.\r\n\r\n[b]NOTE:[/b] Don't tag individual Touhou games unless the game is directly referenced by the post. All of the characters in a picture having debuted in the same game is not enough to count. The full cast of a game (with or without the protagonists) appearing will usually count, so long as no other characters are present.\r\n\r\nA \"Direct Reference\" can include, but may not be limited to:\r\n* Depiction of [[gameplay mechanics]] found in the game (post #4907093)\r\n* Any kind of [[parody]] of the game or other work (post #4546543)\r\n* A character drawn in a pose from their official art (post #4495699)\r\n* A character wearing an outfit from a game or other work instead of their \"usual\" outfit, ranging from outfits that only differ slightly (post #4419411), to outfits that differ entirely, (e.g [[Turbo Byakuren]]). This may also include physical changes specific for a game (post #1366406)\r\n* The name of the game or other work being written in the post (post #3865937)\r\n\r\nh4#games. Games \r\n\r\nh5. [[Touhou (PC-98)|PC-98 Generation]]\r\n\r\n* 東方靈異伝 (Touhou Rei'iden) ～ [[Highly Responsive to Prayers|the Highly Responsive to Prayers]] \r\n* 東方封魔録 (Touhou Fuumaroku) ～ [[Story of Eastern Wonderland|the Story of Eastern Wonderland]] \r\n* 東方夢時空 (Touhou Yumejikuu) ～ [[Phantasmagoria of Dim.Dream]] \r\n* 東方幻想郷 (Touhou Gensoukyou) ～ [[Lotus Land Story]] \r\n* 東方怪綺談 (Touhou Kaikidan) ～ [[Mystic Square]] \r\n\r\nh5. Windows Generation \r\n\r\nH6. Generation 1\r\n* 東方紅魔郷 (Touhou Komakyou) ～ [[Embodiment of Scarlet Devil|the Embodiment of Scarlet Devil]] \r\n* 東方妖々夢 (Touhou Youyoumu) ～ [[Perfect Cherry Blossom]] \r\n* 東方萃夢想 (Touhou Suimusou) ～ [[Immaterial and Missing Power]] \r\n* 東方永夜抄 (Touhou Eiyashou) ～ [[Imperishable Night]] \r\n* 東方花映塚 (Touhou Kaeizuka) ～ [[Phantasmagoria of Flower View]] \r\n* 東方文花帖 (Touhou Bunkachou) ～ [[Shoot the Bullet]] \r\nH6. Generation 2\r\n* 東方風神録 (Touhou Fuujinroku) ～ [[Mountain of Faith]] \r\n* 東方緋想天 (Touhou Hisouten) ～ [[Scarlet Weather Rhapsody]] \r\n* 東方地霊殿 (Touhou Chireiden) ～ [[Subterranean Animism]] \r\n* 東方星蓮船 (Touhou Seirensen) ～ [[Undefined Fantastic Object]] \r\n* 東方非想天則 ([[Touhou Hisoutensoku]]) \r\n* ダブルスポイラー ～ 東方文花帖 ([[Double Spoiler]] ～ Touhou Bunkachou) \r\n* 妖精大戦争 ～ 東方三月精 ([[Yousei Daisensou]] ～ Touhou Sangetsusei) \r\n* 東方神霊廟 (Touhou Shinreibyou) ～ [[Ten Desires]] \r\n* 東方心綺楼 (Touhou Shinkirou) ～ [[Hopeless Masquerade]]\r\nH6. Generation 3\r\n* 東方輝針城 (Touhou Kishinjou) ～ [[Double Dealing Character]]\r\n* ","response_truncated":true,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2","status":"source_backed"}],"matched_documents":[{"title":"touhou","original":"\"東方\" (Japanese for \"eastern\") \r\n\r\nA series of \"bullet hell\" vertical shooter games created by [[ZUN (artist)|]], featuring a large cast of girls and almost no male characters.\r\n\r\nTouhou first appeared on the NEC PC-9801 computers in its first five games between 1996 and 1998 before going into hiatus, during which time ZUN left his former team, Amusement Makers. These games make up the [[Touhou (PC-98)]] era. In 2002 he returned as the one-man doujin group [i]Team Shanghai Alice[/i] and released Touhou for Windows, thus exposing it to a larger audience. \r\n\r\nThe games themselves, mostly in the [[danmaku]] (\"bullet hell\") genre, are addictive and have acquired a large following. In particular, his original music is incredibly popular and is the subject of numerous doujin remix albums.\r\n\r\nCurrently Touhou has twenty mainstream danmaku shooter games, six danmaku spinoffs, six fighting spinoffs and an action spinoff, with the fighting games and action game made in collaboration with Tasogare Frontier. The series also has a number of supplementary materials including manga, short stories, fanbooks, and music CDs.\r\n\r\nThe backgrounds and personalities of its characters (the majority of which come from the Windows generation) are often expanded upon in doujins and, occasionally, ZUN canonizes some concepts. \r\n\r\nTouhou is also notable for being a [i]de facto[/i] open source franchise, in which ZUN allows various fan works such as doujinshi and video games to be published and sold with little to no licensing fees. This allowed the franchise to remain popular to this day.\r\n\r\n[b]NOTE:[/b] Don't tag individual Touhou games unless the game is directly referenced by the post. All of the characters in a picture having debuted in the same game is not enough to count. The full cast of a game (with or without the protagonists) appearing will usually count, so long as no other characters are present.\r\n\r\nA \"Direct Reference\" can include, but may not be limited to:\r\n* Depiction of [[gameplay mechanics]] found in the game (post #4907093)\r\n* Any kind of [[parody]] of the game or other work (post #4546543)\r\n* A character drawn in a pose from their official art (post #4495699)\r\n* A character wearing an outfit from a game or other work instead of their \"usual\" outfit, ranging from outfits that only differ slightly (post #4419411), to outfits that differ entirely, (e.g [[Turbo Byakuren]]). This may also include physical changes specific for a game (post #1366406)\r\n* The name of the game or other work being written in the post (post #3865937)\r\n\r\nh4#games. Games \r\n\r\nh5. [[Touhou (PC-98)|PC-98 Generation]]\r\n\r\n* 東方靈異伝 (Touhou Rei'iden) ～ [[Highly Responsive to Prayers|the Highly Responsive to Prayers]] \r\n* 東方封魔録 (Touhou Fuumaroku) ～ [[Story of Eastern Wonderland|the Story of Eastern Wonderland]] \r\n* 東方夢時空 (Touhou Yumejikuu) ～ [[Phantasmagoria of Dim.Dream]] \r\n* 東方幻想郷 (Touhou Gensoukyou) ～ [[Lotus Land Story]] \r\n* 東方怪綺談 (Touhou Kaikidan) ～ [[Mystic Square]] \r\n\r\nh5. Windows Generation \r\n\r\nH6. Generation 1\r\n* 東方紅魔郷 (Touhou Komakyou) ～ [[Embodiment of Scarlet Devil|the Embodiment of Scarlet Devil]] \r\n* 東方妖々夢 (Touhou Youyoumu) ～ [[Perfect Cherry Blossom]] \r\n* 東方萃夢想 (Touhou Suimusou) ～ [[Immaterial and Missing Power]] \r\n* 東方永夜抄 (Touhou Eiyashou) ～ [[Imperishable Night]] \r\n* 東方花映塚 (Touhou Kaeizuka) ～ [[Phantasmagoria of Flower View]] \r\n* 東方文花帖 (Touhou Bunkachou) ～ [[Shoot the Bullet]] \r\nH6. Generation 2\r\n* 東方風神録 (Touhou Fuujinroku) ～ [[Mountain of Faith]] \r\n* 東方緋想天 (Touhou Hisouten) ～ [[Scarlet Weather Rhapsody]] \r\n* 東方地霊殿 (Touhou Chireiden) ～ [[Subterranean Animism]] \r\n* 東方星蓮船 (Touhou Seirensen) ～ [[Undefined Fantastic Object]] \r\n* 東方非想天則 ([[Touhou Hisoutensoku]]) \r\n* ダブルスポイラー ～ 東方文花帖 ([[Double Spoiler]] ～ Touhou Bunkachou) \r\n* 妖精大戦争 ～ 東方三月精 ([[Yousei Daisensou]] ～ Touhou Sangetsusei) \r\n* 東方神霊廟 (Touhou Shinreibyou) ～ [[Ten Desires]] \r\n* 東方心綺楼 (Touhou Shinkirou) ～ [[Hopeless Masquerade]]\r\nH6. Generation 3\r\n* 東方輝針城 (Touhou Kishinjou) ～ [[Double Dealing Character]]\r\n* ","response_truncated":true,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2","status":"source_backed"}],"aliases":[],"identity_evidence":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2","status":"source_backed","type":"page","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"exact","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2","citations":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2"}]},{"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"7021"},"locator":null,"descriptions":[{"title":"11","original":"For the artist formerly tagged here, see [[11 (yoshitaka)]].","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2545","status":"source_backed"}],"matched_documents":[{"title":"11","original":"For the artist formerly tagged here, see [[11 (yoshitaka)]].","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2545","status":"source_backed"}],"aliases":[{"text":"11","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2545","status":"source_backed"}],"identity_evidence":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2545","status":"source_backed","type":"page","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2545","citations":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:2545"}]},{"entry_key":{"kind":"person","namespace":"bangumi.person","value":"11"},"locator":null,"descriptions":[{"title":"赤井孝美","original":"日本男性插画家、企划制作人。GAINAX所属，本身经营同人社团“Stiletto”（ステイレット）、NINELIVES公司。\r\n\r\n鸟取县米子市出身。鸟取县立境高等学校、大阪艺术大学艺术学院映像计画学系毕业，其妻为漫画家樋口纪美子（樋口 紀美子→ひぐち きみこ）。\r\n在大学时认识同一学院的山贺博之、庵野秀明，另外岛本和彦和南雅彦也是大学同期生。当时与山贺、庵野等人组成DAICON FILM参加第20回日本科幻大会（DAICON III），负责OP的人物设计；后来一起成立GAINAX。\r\n1992年12月28日，从GAINAX独立开设“有限会社AKAI”（有限会社エーケーエーアイ），1996年更名“有限会社NINELIVES”（有限会社ナインライブス，NINELIVES, Inc.）。2001年，回到GAINAX担任董事，NINELIVES呈休业状态，NINELIVES商品贩卖、官网营运由GAINAX代行。2007年4月4日，卷入《天元突破》的网络舌战，不慎出言不逊，只得公开道歉并辞去GAINAX董事一职。\r\n除插画家身份外，也参与原案、人物设计、游戏创作等工作，在多方领域活跃。1991年，监督、脚本、人物设计一手包办的游戏《美少女梦工场》发表，掀起美少女养成游戏风潮，被誉为“美少女之父”。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912039","status":"source_backed"}],"matched_documents":[{"title":"赤井孝美","original":"日本男性插画家、企划制作人。GAINAX所属，本身经营同人社团“Stiletto”（ステイレット）、NINELIVES公司。\r\n\r\n鸟取县米子市出身。鸟取县立境高等学校、大阪艺术大学艺术学院映像计画学系毕业，其妻为漫画家樋口纪美子（樋口 紀美子→ひぐち きみこ）。\r\n在大学时认识同一学院的山贺博之、庵野秀明，另外岛本和彦和南雅彦也是大学同期生。当时与山贺、庵野等人组成DAICON FILM参加第20回日本科幻大会（DAICON III），负责OP的人物设计；后来一起成立GAINAX。\r\n1992年12月28日，从GAINAX独立开设“有限会社AKAI”（有限会社エーケーエーアイ），1996年更名“有限会社NINELIVES”（有限会社ナインライブス，NINELIVES, Inc.）。2001年，回到GAINAX担任董事，NINELIVES呈休业状态，NINELIVES商品贩卖、官网营运由GAINAX代行。2007年4月4日，卷入《天元突破》的网络舌战，不慎出言不逊，只得公开道歉并辞去GAINAX董事一职。\r\n除插画家身份外，也参与原案、人物设计、游戏创作等工作，在多方领域活跃。1991年，监督、脚本、人物设计一手包办的游戏《美少女梦工场》发表，掀起美少女养成游戏风潮，被誉为“美少女之父”。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912039","status":"source_backed"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912039","status":"source_backed","type":"person","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"exact","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912039","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:912039"}]},{"entry_key":{"kind":"person","namespace":"bangumi.person","value":"96291"},"locator":null,"descriptions":[{"title":"11","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1007383","status":"source_backed"}],"matched_documents":[{"title":"11","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:1007383","status":"source_backed"}],"aliases":[{"text":"11","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb76