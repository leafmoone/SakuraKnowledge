{"contract_version":"2","response_version":"3","snapshot":"373fcb69731db877929c102b75292142c0ccff1b5f6075310acc03432ddb6b8b","query":"孤独摇滚","status":"ambiguous","entry_key":null,"tag_key":null,"canonical":null,"candidates":[{"entry_key":{"kind":"episode","namespace":"bangumi.episode","value":"1128648"},"locator":null,"descriptions":[{"title":"ぼっち・ざ・ろっく","original":"ライブ当日。台風の影響で呼んでいたはずの家族や友達から続々とキャンセルの連絡がきてしまう。直前になってもお客さんはまばら、重い雰囲気のなか結束バンドは４人としての初ライブを迎える。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：斎藤圭一郎\r\n演出：瀬尾健\r\n作画監督：けろりら、Franziska van Wulfen、TOMATO","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:2098630","status":"source_backed"}],"matched_documents":[{"title":"ぼっち・ざ・ろっく","original":"ライブ当日。台風の影響で呼んでいたはずの家族や友達から続々とキャンセルの連絡がきてしまう。直前になってもお客さんはまばら、重い雰囲気のなか結束バンドは４人としての初ライブを迎える。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：斎藤圭一郎\r\n演出：瀬尾健\r\n作画監督：けろりら、Franziska van Wulfen、TOMATO","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:2098630","status":"source_backed"}],"aliases":[{"text":"孤独摇滚","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:2098630","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:2098630","status":"source_backed","type":"episode","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc