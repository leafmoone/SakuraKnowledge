e,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:275159","status":"source_backed"}],"matched_documents":[{"title":"kokonoe_(shinitagari_no_seijo_ni_shiawase_na_shuumatsu_wo.)","original":"A character from [[Shinitagari no Seijo ni Shiawase na Shuumatsu wo.]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:275159","status":"source_backed"}],"aliases":[],"identity_evidence":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:275159","status":"source_backed","type":"page","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"exact","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:275159","citations":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:275159"}]},{"entry_key":{"kind":"subject","namespace":"bangumi.subject","value":"285079"},"locator":null,"descriptions":[{"title":"サンゴ礁伝説 青い海のエルフィ","original":"　　自然破壊が原因による大洪水で、大陸が水没してから4世紀後の世界。自然を愛する少女エルフィは、兄弟のように育てられた少年アルカスと共に平和に暮らしていたが、やがて自分が古代ムー大陸の民である水棲人であることを知ってしまう。彼女の生まれ育った地上に住む人間たちの国・ネプチューン国では、海洋開発を推進しようとしていたが、それを快く思わない水棲人の抵抗運動によって、両者は一触即発の状態に陥っていた。エルフィは戦いをやめさせようとするが、対立はどんどん深まっていく。現代社会の持つ課題である環境問題を子供にも分かりやすく取り入れて作られた、未来SFアニメーション。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:275182","status":"source_backed"}],"matched_documents":[{"title":"サンゴ礁伝説 青い海のエルフィ","original":"　　自然破壊が原因による大洪水で、大陸が水没してから4世紀後の世界。自然を愛する少女エルフィは、兄弟のように育てられた少年アルカスと共に平和に暮らしていたが、やがて自分が古代ムー大陸の民である水棲人であることを知ってしまう。彼女の生まれ育った地上に住む人間たちの国・ネプチューン国では、海洋開発を推進しようとしていたが、それを快く思わない水棲人の抵抗運動によって、両者は一触即発の状態に陥っていた。エルフィは戦いをやめさせようとするが、対立はどんどん深まっていく。現代社会の持つ課題である環境問題を子供にも分かりやすく取り入れて作られた、未来SFアニメーション。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:275182","status":"source_backed"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:275182","status":"source_backed","type":"subject","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"exact","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:275182","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:275182"}]}],"descriptions":[],"relations":[],"citations":[],"warnings":[]}
