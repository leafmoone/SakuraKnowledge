ted":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881837","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881837"}],"score":-34.76859197789309},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"193359"},"locator":null,"descriptions":[{"title":"白鹰","original":"拥有强大的工业实力，先进的科学技术以及各势力中最优秀的航空兵器。武器的设计理念兼顾性能与数量。现在基于贯彻自身正义和为世界带来和平的理念留在碧蓝航线，在与赤色中轴和塞壬的战斗中有着活跃表现。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881815","status":"source_backed"}],"matched_documents":[{"title":"白鹰","original":"拥有强大的工业实力，先进的科学技术以及各势力中最优秀的航空兵器。武器的设计理念兼顾性能与数量。现在基于贯彻自身正义和为世界带来和平的理念留在碧蓝航线，在与赤色中轴和塞壬的战斗中有着活跃表现。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881815"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881815","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881815","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881815"}],"score":-32.522870528700494},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"193362"},"locator":null,"descriptions":[{"title":"皇家","original":"世界上造船经验最丰富的的国家，在军舰设计上致力于最佳的平衡性能，海军实力“不容置疑”。皇家阵营讲究礼仪，注重优雅与实力并存。皇家为了捍卫皇家的荣耀，夺回人类的制海权，现在依然停留在碧蓝航线的阵营，参与对塞壬和赤色中轴的作战行动。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881818","status":"source_backed"}],"matched_documents":[{"title":"皇家","original":"世界上造船经验最丰富的的国家，在军舰设计上致力于最佳的平衡性能，海军实力“不容置疑”。皇家阵营讲究礼仪，注重优雅与实力并存。皇家为了捍卫皇家的荣耀，夺回人类的制海权，现在依然停留在碧蓝航线的阵营，参与对塞壬和赤色中轴的作战行动。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881818"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881818","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881818","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881818"}],"score":-31.439822787414837},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"193368"},"locator":null,"descriptions":[{"title":"北方联合","original":"北方联合倡导集体主义与对社会的奉献，拥有坚定的目标和达成目标所需的无畏的勇气，北方联合将几乎全部舰队调往极地地区，很少参与碧蓝航线阵营内的联合行动，目前除了已知北方联合还在极地与塞壬作战外，其余情报尚不明确。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881824","status":"source_backed"}],"matched_documents":[{"title":"北方联合","original":"北方联合倡导集体主义与对社会的奉献，拥有坚定的目标和达成目标所需的无畏的勇气，北方联合将几乎全部舰队调往极地地区，很少参与碧蓝航线阵营内的联合行动，目前除了已知北方联合还在极地与塞壬作战外，其余情报尚不明确。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881824"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881824","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881824","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881824"}],"score":-31.30949267367572},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"193372"},"locator":null,"descriptions":[{"title":"撒丁帝国","original":"悠久的历史与绚烂的艺术，相比军事实力，撒丁帝国对于自身的文化传承拥有更深的自豪感。海军军事组织为禁卫军。虽然元老院内部的声音一直没有统一，但是事实上来说，撒丁帝国已经成为了赤色中轴阵营的一员，走向了与碧蓝航线不同的方向。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881828","status":"source_backed"}],"matched_documents":[{"title":"撒丁帝国","original":"悠久的历史与绚烂的艺术，相比军事实力，撒丁帝国对于自身的文化传承拥有更深的自豪感。海军军事组织为禁卫军。虽然元老院内部的声音一直没有统一，但是事实上来说，撒丁帝国已经成为了赤色中轴阵营的一员，走向了与碧蓝航线不同的方向。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881828"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881828","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881828","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881828"}],"score":-31.052047401352453},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"193366"},"locator":null,"descriptions":[{"title":"铁血","original":"拥有众多优秀的科学家，在与塞壬的战争中获得了大量新技术，并着眼于对这些技术的进一步开发，这使得铁血的人工智能控制技术和生物工程技术遥遥领先于其他势力。退出碧蓝航线阵营后，铁血一度处于消息不明的状态，现在则是作为赤色中轴阵营的成员而活动着。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881822","status":"source_backed"}],"matched_documents":[{"title":"铁血","original":"拥有众多优秀的科学家，在与塞壬的战争中获得了大量新技术，并着眼于对这些技术的进一步开发，这使得铁血的人工智能控制技术和生物工程技术遥遥领先于其他势力。退出碧蓝航线阵营后，铁血一度处于消息不明的状态，现在则是作为赤色中轴阵营的成员而活动着。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881822"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881822","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881822","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:881822"}],"score":-29.94406672538976},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"120468"},"locator":null,"descriptions":[{"title":"ブルー","original":"碧蓝是一位追求稀有且强大宝可梦的女孩。\r\n\r\n经历\r\n《Let's Go! 皮卡丘／Let's Go! 伊布》\r\n登入名人堂后，可以在华蓝洞窟遇见前来捕捉超梦的碧蓝。主角捕捉超梦并与华蓝洞窟外的小进对话后，再次前往华蓝洞窟最深处就能遇见碧蓝。第一次遇见她时，她会误以为主角是宝可梦而丢出一个精灵球。击败她后，碧蓝会赠送超梦进化石Ｘ和超梦进化石Ｙ，然后请求主角和超梦一起来当她的宝可梦并向主角连续丢出5个精灵球。宝可梦联盟再挑战胜利后，碧蓝会在华蓝市喷水池南侧出现，主角每天能与她进行一次对战，击败她之后碧蓝会像之前一样向主角丢5个精灵球，并表示希望主角接受自己的想法。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:809012","status":"source_backed"}],"matched_documents":[{"title":"ブルー","original":"碧蓝是一位追求稀有且强大宝可梦的女孩。\r\n\r\n经历\r\n《Let's Go! 皮卡丘／Let's Go! 伊布》\r\n登入名人堂后，可以在华蓝洞窟遇见前来捕捉超梦的碧蓝。主角捕捉超梦并与华蓝洞窟外的小进对话后，再次前往华蓝洞窟最深处就能遇见碧蓝。第一次遇见她时，她会误以为主角是宝可梦而丢出一个精灵球。击败她后，碧蓝会赠送超梦进化石Ｘ和超梦进化石Ｙ，然后请求主角和超梦一起来当她的宝可梦并向主角连续丢出5个精灵球。宝可梦联盟再挑战胜利后，碧蓝会在华蓝市喷水池南侧出现，主角每天能与她进行一次对战，击败她之后碧蓝会像之前一样向主角丢5个精灵球，并表示希望主角接受自己的想法。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:809012"}],"aliases":[],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:809012","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"fts","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:809012","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:809012"}],"score":-16.42099381857496}],"descriptions":[],"relations":[],"citations":[],"warnings":[]}
