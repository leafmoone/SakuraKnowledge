{"contract_version":"2","response_version":"3","snapshot":"373fcb69731db877929c102b75292142c0ccff1b5f6075310acc03432ddb6b8b","query":"美坂栞","status":"ambiguous","entry_key":null,"tag_key":null,"canonical":null,"candidates":[{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"1000"},"locator":null,"descriptions":[{"title":"美坂栞","original":"祐一的学妹，香里的妹妹。祐一和亚由跑到商店街外面时偶然相遇的少女。喜欢的食物是冰淇淋，就算是身处严冬的雪国还是能若无其事的吃香草冰淇淋。但是没办法吃咖哩，对辣的食物厌恶到称之为“人类的敌人”的地步。口头禅是“我讨厌说那种话的人”。从小身体孱弱，现在也是长期缺席没去上学。但是偶而会穿着便服溜进学校里。兴趣是素描，但是不擅长画人物画。另外，反应速度十分的慢，玩打地鼠之类的游戏时连一次也打不到(后来有所进步)。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691007","status":"source_backed"}],"matched_documents":[{"title":"美坂栞","original":"祐一的学妹，香里的妹妹。祐一和亚由跑到商店街外面时偶然相遇的少女。喜欢的食物是冰淇淋，就算是身处严冬的雪国还是能若无其事的吃香草冰淇淋。但是没办法吃咖哩，对辣的食物厌恶到称之为“人类的敌人”的地步。口头禅是“我讨厌说那种话的人”。从小身体孱弱，现在也是长期缺席没去上学。但是偶而会穿着便服溜进学校里。兴趣是素描，但是不擅长画人物画。另外，反应速度十分的慢，玩打地鼠之类的游戏时连一次也打不到(后来有所进步)。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691007","status":"source_backed"}],"aliases":[{"text":"美坂栞","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691007","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691007","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complet