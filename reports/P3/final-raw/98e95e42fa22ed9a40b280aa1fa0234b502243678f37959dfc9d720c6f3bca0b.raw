{"candidates":[],"candidates_truncated":false,"canonical_status":"canonical","citations":[],"contract_version":"2","descriptions":[{"evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:145207","original":"Character in [[Bocchi the Rock!]]. Her name is a pun on \"I'm here! Let's go!\"\r\n\r\nShe has [[green eyes]] and [[long hair|long]] [[red hair]] stylized with a [[one side up]], and [[hair between eyes]]. She usually wears the [[Shuka High School uniform]] consisting of a [[white sailor collar]], [[red bowtie]], [[long sleeves|long sleeved]] [[brown cardigan|brown]] [[cardigan]], a [[black skirt|black]] [[pleated skirt]], [[white socks]] and [[brown footwear|brown]] [[loafers]]. She [[playing instrument|plays]] the [[guitar]].\r\n\r\nShe is voiced by [[Hasegawa Ikumi]].\r\n\r\nh4. Appearance\r\n\r\n* !post #7506351","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","status":"source_backed","title":"kita_ikuyo"}],"evidence_chain":[{"evidence_id":"native:1782917","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8.raw","raw_sha256":"4ccce02e466f4f14ee4a5252b48b72c33b53db57c6b470fe7307e40a3668a7b8","role":"native_identity","source_id":"danbooru-native-scoped-4ccce02e466f","tag_id":1782917},{"active_alias_ids":[],"coverage":"scoped_complete","evidence_id":"scope:kita_ikuyo","fetched_at_utc":"2026-09-30T06:43:51.470845+00:00","name":"kita_ikuyo","raw_path":"reports/P3/raw/4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945.raw","raw_sha256":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","role":"canonical_scope","source_id":"danbooru-native-scoped-4ccce02e466f"},{"association":"official embedded tag.wiki_page","evidence_id":"wiki:151533","fetched_at_utc":"2026-09-30T06:43:34.899059+00:00","raw_path":"reports/P3/raw/4ccce02e466f4f14ee4