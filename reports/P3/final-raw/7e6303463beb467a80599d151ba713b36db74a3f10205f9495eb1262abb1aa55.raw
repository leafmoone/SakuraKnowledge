6a75aefb769a","status":"source_backed","title":"美坂香里"}],"entry_key":{"kind":"character","namespace":"bangumi.character","value":"1004"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691011","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691011","locator":null,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","type":"character"}],"identity_evidence_truncated":false,"locator":null,"matched_by":"fts","matched_documents":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:691011","original":"名雪的挚友、祐一的同学。个性冷静、负责吐槽（ツッコミ）、身兼班长的全学年第一的秀才。也有模仿名雪等淘气的一面。照理说应该是美坂栞的姐姐，因为妹妹病重，担心妹妹去世会难以割舍，所以否认自己有妹妹。","response_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","title":"美坂香里"}],"score":-28.870054036432897,"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"source_id":"bangumi-complete-6a75aefb769a"},{"aliases":[],"citations":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:620187","source_id":"bangumi-complete-6a75aefb769a"}],"descriptions":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:620187","original":"テレビアニメ化されたＰＣゲーム『Ｋａｎｏｎ』漫画版、感涙のフィナーレ！\r\n\r\n沢渡真琴、川澄舞、美坂栞、月宮あゆ…ヒロインたちの視点で描く新たなＫａｎｏｎ。雪の街を舞台にした小さな奇跡の物語の結末は……！？","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","status":"source_backed","title":"KANON ホントの想いは笑顔の向こう側に (2)"}],"entry_key":{"kind":"subject","namespace":"bangumi.subject","value":"636388"},"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:620187","identity_evidence":[{"evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc19