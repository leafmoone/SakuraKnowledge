}],"matched_documents":[{"title":"山田一郎","original":"元【The Dirty Dawg】メンバー。\r\n山田家長男。\r\n萬屋ヤマダの経営者。\r\nかつてはイケブクロでは名を知らない者がいないほどの不良だった。\r\n情に厚く、困っている者は見捨てられない正義漢。\r\n兄弟思いで面倒見が良いため、誰からも慕われている。\r\nアニメ鑑賞が好きで、ラノベは新刊を全て読み漁るほどのオタク。\r\nヨコハマ・ディビジョンの碧棺左馬刻とは犬猿の仲。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754663","status":"source_backed"}],"aliases":[{"text":"山田一郎","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754663","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754663","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754663","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:754663"}]},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"94968"},"locator":null,"descriptions":[{"title":"山田一郎","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:783549","status":"source_backed"}],"matched_documents":[{"title":"山田一郎","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb76