:15568"}]},{"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"213956"},"locator":null,"descriptions":[{"title":"yamada_ichirou_(ao_no_orchestra)","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:206419","status":"source_backed"}],"matched_documents":[{"title":"yamada_ichirou_(ao_no_orchestra)","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:206419","status":"source_backed"}],"aliases":[{"text":"山田一郎","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:206419","status":"source_backed"}],"identity_evidence":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:206419","status":"source_backed","type":"page","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:206419","citations":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:206419"}]},{"entry_key":{"kind":"page","namespace":"danbooru.wiki","value":"99373"},"locator":null,"descriptions":[{"title":"yamada_ichiro","original":"A [i][[Hypnosis Mic]][/i] character. Operates under the name \"MC.B.B. (MC Big Brother)\".\r\n\r\nIchiro is the eldest son of the Yamada family and runs an odd jobs business called Yorozuya Yamada while taking care of his two younger brothers, [[Yamada Jiro|Jiro]] and [[Yamada Saburo|Saburo]]. He is secretly a huge [[otaku]]. A former member of Naughty Busters, [[Mad Comic Dialogue]], and [[The Dirty Dawg]], as well as the current leader of [[Buster Bros!!!]].\r\n\r\nFundamentally charismatic and dependable, Ichiro is a man of justice who never abandons those in need, but he was once a delinquent known to all of Ikebukuro. Despite being only 19 years old, he possesses a maturity beyond his years and takes on the responsibilities of both a mother and father figure to his two younger brothers. He believes in the potential that words hold and aims to create a world where everyone can laugh together.\r\n\r\nHe is associated with the keycap digit one 1️⃣ emoji.\r\n\r\nh4. Appearance\r\n* !asset #19301094: Default\r\n* !asset #19561628: With speakers and [[hypnosis microphone]]\r\n* !asset #19561714: [[yamada ichiro (tdd era)|TDD Era]]\r\n* !asset #33593810: [[yamada_ichiro_(sanrio_nakayoku_edit)|Sanrio collaboration]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:93054","status":"source_backed"}],"matched_documents":[{"title":"yamada_ichiro","original":"A [i][[Hypnosis Mic]][/i] character. Operates under the name \"MC.B.B. (MC Big Brother)\".\r\n\r\nIchiro is the eldest son of the Yamada family and runs an odd jobs business called Yorozuya Yamada while taking care of his two younger brothers, [[Yamada Jiro|Jiro]] and [[Yamada Saburo|Saburo]]. He is secretly a huge [[otaku]]. A former member of Naughty Busters, [[Mad Comic Dialogue]], and [[The Dirty Dawg]], as well as the current leader of [[Buster Bros!!!]].\r\n\r\nFundamentally charismatic and dependable, Ichiro is a man of justice who never abandons those in need, but he was once a delinquent known to all of Ikebukuro. Despite being only 19 years old, he possesses a maturity beyond his years and takes on the responsibilities of both a mother and father figure to his two younger brothers. He believes in the potential that words hold and aims to create a world where everyone can laugh together.\r\n\r\nHe is associated with the keycap digit one 1️⃣ emoji.\r\n\r\nh4. Appearance\r\n* !asset #19301094: Default\r\n* !asset #19561628: With speakers and [[hypnosis microphone]]\r\n* !asset #19561714: [[yamada ichiro (tdd era)|TDD Era]]\r\n* !asset #33593810: [[yamada_ichiro_(sanrio_nakayoku_edit)|Sanrio collaboration]]","response_truncated":false,"search_text_truncated":false,"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:93054","status":"source_backed"}],"aliases":[{"text":"山田一郎","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:93054","status":"source_backed"}],"identity_evidence":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:93054","status":"source_backed","type":"page","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:93054","citations":[{"source_id":"danbooru-complete-a26a3829dd42","evidence_id":"danbooru-complete-a26a3829dd42:a26a3829dd42155848392c0636daebd6ca01acf540d3509fec2ac3219f8596c5:line:93054"}]},{"entry_key":{"kind":"subject","namespace":"bangumi.subject","value":"58774"},"locator":null,"descriptions":[{"title":"となりのランドセルw","original":"　　山田一郎正热切地暗恋着藤崎栞。