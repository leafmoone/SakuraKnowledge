一郎","original":"幼少期からチェロを習っている、人懐っこい性格の少年。青野やハルとは違う中学校だったが、二人のことはコンクールで何度か顔を合わせているので知っている。佐伯とは同じ中学で仲が良い。女子が多いオケ部に入部し、あわよくばモテたいと思っている。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:814523","status":"source_backed"}],"matched_documents":[{"title":"山田一郎","original":"幼少期からチェロを習っている、人懐っこい性格の少年。青野やハルとは違う中学校だったが、二人のことはコンクールで何度か顔を合わせているので知っている。佐伯とは同じ中学で仲が良い。女子が多いオケ部に入部し、あわよくばモテたいと思っている。","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:814523","status":"source_backed"}],"aliases":[{"text":"山田一郎","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:814523","status":"source_backed"}],"identity_evidence":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:814523","status":"source_backed","type":"character","locator":null}],"source_fields":{},"source_fields_evidence":[],"source_fields_truncated":[],"identity_evidence_truncated":false,"matched_by":"alias","source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:814523","citations":[{"source_id":"bangumi-complete-6a75aefb769a","evidence_id":"bangumi-complete-6a75aefb769a:6a75aefb769a62f0eaa3b58ed76fb172a5dc1922a9e5be40bd7de2ff8343dcc4:line:814523"}]},{"entry_key":{"kind":"character","namespace":"bangumi.character","value":"161266"},"locator":null,"descriptions":[{"title":"山田一郎","original":"","response_truncated":false,"search_text_truncated":false,"source_id":"bangumi-complete-6a75aefb76